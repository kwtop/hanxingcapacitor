# Local values only. Run npm run setup:admin to generate private local credentials.
APP_ENV=local
APP_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://127.0.0.1:4340,http://127.0.0.1:4342,http://localhost:4342
ADMIN_AUTH_MODE=password
ADMIN_EMAIL=admin@hanxing.local
ADMIN_PASSWORD_HASH=pbkdf2_sha256$100000$salt-in-hex$derived-key-in-hex
# Production: create a real Turnstile widget for the selected hostname.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional production Cloudflare Access mode (verified JWT + email allowlist).
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ACCESS_ALLOWED_EMAILS=
INTERNAL_IPS=
