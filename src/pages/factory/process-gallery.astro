---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OemDispatchVideos from '../../components/sunday/OemDispatchVideos.astro';
import OemPageHero from '../../components/sunday/OemPageHero.astro';
import OemPhotoCollection from '../../components/sunday/OemPhotoCollection.astro';
import OemReading from '../../components/sunday/OemReading.astro';
import OemWorkshopImage from '../../components/sunday/OemWorkshopImage.astro';
import { oemProcessGallery } from '../../data/oemWorkshopPhotography';
import '../../styles/oem-editorial.css';
---
<BaseLayout title="Capacitor Production Process Gallery" description="See capacitor film-processing equipment, metal cases, terminals and packing. Watch four videos of pallets and trucks in the loading area.">
  <article class="oem-suite oe-gallery-page">
    <OemPageHero titleId="pg-title" title="Inside the workshop" description="Explore film equipment, metal can bodies, packing stations and pallet loading." current="Process gallery" parent={{label:'Manufacturing',href:'/factory/'}} layout="split">
      <a class="oe-link" href="/factory/">Watch the production footage</a>
      <OemWorkshopImage slot="media" name="09-assembly-machine" eager />
    </OemPageHero>
    <div id="pg-intro-title" class="oe-gallery-guide oe-shell"><p>Select an image for a closer look, or expand a group to browse the complete sequence.</p></div>
    {oemProcessGallery.map(chapter => chapter.id === 'dispatch' ? (
      <OemPhotoCollection id={chapter.id} title={chapter.title} photos={[]}>
        <OemDispatchVideos slot="media" />
      </OemPhotoCollection>
    ) : (
      <OemPhotoCollection id={chapter.id} title={chapter.title} intro={chapter.intro} photos={chapter.photos} expandLabel={`View all ${chapter.photos.length} images in this group`} />
    ))}
    <OemReading title="For your order" links={[{title:'Product documents',description:'Model drawings, inspection reports and certificate details.',href:'/factory/#model-records'},{title:'OEM requirements',description:'Your label and packaging on the selected model.',href:'/oem/'},{title:'Packing and dispatch',description:'Unit protection, carton quantities and carrier records.',href:'/factory/packing-and-dispatch/'}]} />
  </article>
</BaseLayout>
