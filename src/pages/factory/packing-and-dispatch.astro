---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OemPageHero from '../../components/sunday/OemPageHero.astro';
import OemFeature from '../../components/sunday/OemFeature.astro';
import OemReading from '../../components/sunday/OemReading.astro';
import OemPhotoCollection from '../../components/sunday/OemPhotoCollection.astro';
import OemPhotography from '../../components/sunday/OemPhotography.astro';
import BrochurePhoto from '../../components/satechi-preview/BrochurePhoto.astro';
import InquiryCallout from '../../components/InquiryCallout.astro';
import VideoFigure from '../../components/VideoFigure.astro';
import { oemWorkshopImages, oemWorkshopPhoto } from '../../data/oemWorkshopPhotography';
import '../../styles/oem-editorial.css';
import { procurementPolicy } from '../../data/site';
const checklist='/resources/motor-capacitor-order-shipment-checklist/';
const requirements=[
 {name:'Individual protection',description:'Space around terminals and leads, with protection against contact or movement.',values:'Protection method and clearance agreed for the model.'},
 {name:'Inner pack and carton',description:'Dividers or other protection, quantity per inner pack and units per carton.',values:'Pack and carton quantities, carton dimensions, net weight and gross weight.'},
 {name:'Marks and pallets',description:'Shipping marks and language, pallet layout and handling requirements.',values:'Approved marks, pallet arrangement and any special handling instructions.'}
];
const shippingRecords=[
 ['Invoice','Seller and buyer details, invoice and order references, model description, quantities, value and currency.'],
 ['Packing list','Unit quantities by model, carton and pallet counts, shipping marks, dimensions and net and gross weights.'],
 ['Transport record','The consignee, transport method, package count and carrier reference for the shipment.']
];
---
<BaseLayout title="Motor Capacitor Packing & Dispatch" description="Motor capacitor packing requirements for leads, terminals, cartons and pallets, with packing-list and carrier-handover records.">
  <article class="oem-suite oe-packing">
    <OemPageHero titleId="packing-title" title="Packing and dispatch" description="Protect the case and connections in transit. Agree the unit protection, carton quantities and shipping marks for your order." current="Packing & dispatch" layout="split">
      <a class="button" href="/contact/?request=packing#inquiry-form">Discuss your packing</a>
      <OemPhotography slot="media" name="packing-clearance" caption="Clearance around capacitor leads and terminals" eager sizes="(max-width:800px) calc(100vw - 40px), 55vw" />
    </OemPageHero>
    <section class="oe-section" id="packing-requirements"><div class="oe-shell">
      <header class="oe-section-heading"><h2 id="pack-title">Protection for leads and terminals</h2><p>Flexible leads need room for a loose bend. Blade terminals need clearance from the carton and adjacent products. The packing layout depends on the selected model and order quantity.</p></header>
        <table class="procurement-table oe-table procurement-packing-requirements"><caption class="visually-hidden">Motor capacitor packing requirements and values to record</caption><thead><tr><th scope="col">Requirement</th><th scope="col">Packing specification</th></tr></thead><tbody>{requirements.map(item=><tr><th scope="row"><strong>{item.name}</strong><span>{item.description}</span></th><td><span class="procurement-mobile-label" aria-hidden="true">Packing specification</span>{item.values}</td></tr>)}</tbody></table>
      <p>{procurementPolicy.packing}</p>
      <details class="oe-sample-reference"><summary>Product and individual box<span class="oe-disclosure-icon" aria-hidden="true"></span></summary><BrochurePhoto name="cbb65-packaging" zoom label="CBB65 product and individual box" sizes="(max-width:600px) calc(100vw - 40px), 520px" /></details>
      <div class="oe-section-tail"><a class="oe-link" href="/oem/#configuration-approval">Agree label and packing revisions</a></div>
    </div></section>
    <OemFeature id="packing-clip" titleId="packing-footage-title" title="At the packing table" reverse tone="steel">
      <div slot="media"><VideoFigure src="/videos/packing-scene.mp4" poster="/images/real/packing-scene.jpg" label="Individual product boxes being handled at a packing worktable" displayRatio="3/2" cover={oemWorkshopImages['25-packing-worker']} /></div>
      <p>Review the sample pack with the complete capacitor inside, including leads, terminals and fixing parts. The insert should support the body and leave the connections clear.</p>
      <p>The label and box artwork should use the agreed wording and model reference. Record the units per inner pack and carton on the packing specification.</p>
      <a class="oe-link" href="/resources/oem-capacitor-sample-approval/#approve-labels-and-packing">Include packing in sample approval</a>
    </OemFeature>
    <OemPhotoCollection id="packing-dispatch-photos" title="Pallets and the loading lane" intro="Wrapped cartons, pallet arrangement and loading clearance." photos={[oemWorkshopPhoto('28-outdoor-pallets','Pallets in the loading lane'),oemWorkshopPhoto('29-lift-to-truck','Loading at the warehouse')]} moreHref="/factory/process-gallery/#dispatch" moreLabel="More packing and dispatch views" />
    <section class="oe-section" id="handover"><div class="oe-shell oe-terms-layout">
      <div><h2>From packing to pickup</h2><p>Keep packing completion, carrier pickup and delivery as separate milestones. Record actual or estimated dates and who to contact for the next update.</p></div>
      <dl class="oe-records"><div><dt>Dispatch options</dt><dd>{procurementPolicy.dispatch}</dd></div><div><dt>Packing completion</dt><dd>The final packout record gives the unit and package counts, dimensions, weights and marks.</dd></div><div><dt>Carrier handover</dt><dd>The pickup record gives the date and package count. The bill of lading, air waybill or courier reference identifies the shipment for the agreed transport method.</dd></div><div><dt>Delivery update</dt><dd>The carrier reference connects tracking updates to the order. Add the delivery confirmation when it is available.</dd></div></dl>
    </div></section>
    <section class="oe-section oe-section--steel" aria-labelledby="records-title"><div class="oe-shell">
      <header class="oe-section-heading"><h2 id="records-title">Shipping documents</h2><p>Use the purchase-order reference, model descriptions and quantities consistently across the invoice, packing list and transport record. Additional origin or compliance documents depend on the destination and contract.</p></header>
      <table class="procurement-table oe-table procurement-shipping-records"><caption class="visually-hidden">Documents to check against the order and handover record</caption><thead><tr><th scope="col">Record</th><th scope="col">Check against the order</th></tr></thead><tbody>{shippingRecords.map(([name,description])=><tr><th scope="row">{name}</th><td><span class="procurement-mobile-label" aria-hidden="true">Check against the order</span>{description}</td></tr>)}</tbody></table>
      <div class="oe-section-tail"><a class="oe-link" href={checklist}>Delivery terms, payment and document responsibilities</a></div>
    </div></section>
    <OemReading links={[{title:'Order and shipping checklist',description:'Product references, dates, responsibilities and delivery terms.',href:checklist},{title:'OEM sample approval',description:'Record the label and packing revision before confirming an order.',href:'/resources/oem-capacitor-sample-approval/'},{title:'Model documents',description:'Drawings, inspection results and the selected model reference.',href:'/factory/#model-records'}]} />
    <InquiryCallout showVisual={false} href="/contact/?request=packing#inquiry-form" defaultSeries="unknown" heading="Discuss packing and delivery" description="Share the model, quantity and destination." />
  </article>
</BaseLayout>
