---
import { guides } from '../data/guides';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryCallout from '../components/InquiryCallout.astro';
import { applications } from '../data/site';
import { sampleConfigurations } from '../data/sampleConfigurations';
import sampleLibrary from '../data/sampleLibrary.json';
const allowedSeries = ['CBB60', 'CBB61', 'CBB65', 'CD60', 'unknown'];
const contactUrl = new URL('/contact/', Astro.url);
const request = Astro.url.searchParams.get('request') || '';
const guide = Astro.url.searchParams.get('guide') || '';
if (['quote','documents','samples','oem','packing','after-sales'].includes(request)) contactUrl.searchParams.set('request',request);
if (guides.some(item => item.slug === guide)) contactUrl.searchParams.set('guide',guide);
const series = Astro.url.searchParams.get('series') || '';
const application = Astro.url.searchParams.get('application') || '';
if (allowedSeries.includes(series)) contactUrl.searchParams.set('series', series);
const configuration = Astro.url.searchParams.get('configuration') || '';
const photo = Astro.url.searchParams.get('photo') || '';
if (sampleConfigurations.some(item => item.id === configuration && item.series === series)) contactUrl.searchParams.set('configuration', configuration);
if (sampleLibrary.some(item => item.id === photo && (item.series === series || (!Astro.url.searchParams.has('series') && item.series === 'Additional samples')))) contactUrl.searchParams.set('photo', photo);
if (applications.some(item => item.slug === application) || ['hvac', 'pump', 'fan', 'other'].includes(application)) {
  contactUrl.searchParams.set('application', application);
}
---
<BaseLayout title="Request a Motor Capacitor Quote" description="Submit your motor capacitor requirements online, or contact HAN XING by email or WhatsApp. Include the original part details, quantity and destination." noindex>
  <div class="reference-utility">
  <section class="page-hero"><div class="container"><p class="breadcrumbs"><a href="/">Home</a> / Request a Quote</p><h1>Request a motor capacitor quote</h1></div></section>
  <section class="section"><div class="container quote-reading">
    <InquiryCallout contained href={contactUrl.pathname + contactUrl.search + '#inquiry-form'} chooseSeries={!contactUrl.searchParams.has('photo') || contactUrl.searchParams.has('series')}><ul><li>Original capacitor label or exact part number</li><li>Equipment model and run or start function</li><li>Capacitance, voltage, body dimensions and terminal or lead details</li><li>Quantity, destination and any document requirement</li></ul><a class="card-link" href="/buying-guide/">Quotation checklist</a></InquiryCallout>
  </div></section>
  </div>
</BaseLayout>
