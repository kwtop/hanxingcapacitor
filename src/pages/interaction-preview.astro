---
import BaseLayout from '../layouts/BaseLayout.astro';
if (!import.meta.env.DEV) return new Response('Not found', { status: 404 });
const states = [
  { title: '导航与键盘', href: '/products/', action: '桌面将焦点放在 Products，按 ↓ 或 ↑ 展开；方向键切换、Esc 关闭。手机点菜单，展开子级或点击外部收起。', result: '主栏目仍可直达；当前页可识别，关闭弹层后焦点回到入口。' },
  { title: '筛选有结果', href: '/products/?duty=Start', action: '切换 Run / Start，输入系列或额定值；刷新或使用浏览器后退。', result: '条件、URL、可见结果和计数同步；Start 只显示 CD60。' },
  { title: '筛选无结果', href: '/products/?duty=Start&q=CBB65', action: '查看无匹配提示，再点 Clear filters。', result: '保留原搜索条件，清除后恢复四系列，焦点返回搜索框。' },
  { title: '原图筛选与加载更多', href: '/products/photographs/', action: '搜索 P 编号或标签；切换系列；点击 Show more photographs。', result: '保持原始编号和文字，新一批照片出现后焦点进入第一张新增照片。' },
  { title: '图片查看弹窗', href: '/products/photographs/?series=CBB65', action: '点击任一照片，使用 Previous / Next 或 ← / → 切换；Tab、Esc、点击遮罩均可体验。', result: '焦点限制在弹窗内；关闭回到原照片，询盘入口带入对应原图编号。' },
  { title: '图片加载中', href: '/products/photographs/?series=CBB65&ui-state=image-loading', action: '第一张照片保持加载状态；打开查看器，再点击 Load photograph。', result: '固定图片区域显示加载反馈，操作后回到真实图片加载。' },
  { title: '图片加载失败', href: '/products/photographs/?series=CBB65&ui-state=image-error', action: '打开第一张照片，点击 Retry photograph。', result: '错误只影响当前图片；重试后加载真实照片，其他内容仍可使用。' },
  { title: '表单字段错误', href: '/contact/?ui-state=validation', action: '点击错误摘要中的字段，修改姓名、国家、邮箱；也可切换 WhatsApp。', result: '错误出现在对应字段，提交定位到首个错误；切换渠道保留已填内容。' },
  { title: '草稿就绪与修改', href: '/contact/?series=CBB65&configuration=label-p034-50plus5&ui-state=draft-ready', action: '检查草稿参数，修改任一字段，再点 Update inquiry。', result: '旧草稿保留可读，过期时不能复制或打开；更新后恢复操作，始终说明尚未发送。' },
  { title: '复制失败与恢复', href: '/contact/?ui-state=copy-error', action: '点击 Copy message；第一次会进入失败状态，随后可手动复制或再次重试。', result: '自动选中消息并解释如何复制，不清空字段或草稿。' },
  { title: '草稿准备失败与重试', href: '/contact/?ui-state=prepare-error', action: '查看失败提示，再点击 Prepare inquiry。', result: '保留输入，第二次正常生成草稿。' },
  { title: '未知页面', href: '/interaction-preview-missing-page/', action: '从错误页使用产品或首页入口。', result: '真实 HTTP 404，保留明确返回路径。' },
  { title: 'FAQ 搜索与无结果', href: '/faq/?q=shipping', action: '搜索问题与答案，输入无匹配词，再清除搜索；也可使用上方主题锚点。', result: '匹配答案自动展开，计数同步；清除后恢复原来的展开状态。' },
  { title: '技术文章搜索', href: '/resources/articles/?q=terminals', action: '按标签、用途或安装关键词查找指南。', result: '沿用原文章分组和链接，无匹配时显示清除入口。' },
