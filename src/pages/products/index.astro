---
import { usesEditorialPresentation } from '../../lib/visualPreview';
const useEditorial = usesEditorialPresentation(Astro.url.pathname);
import BaseLayout from '../../layouts/BaseLayout.astro';
import InquiryCallout from '../../components/InquiryCallout.astro';
import ProductFilter from '../../components/ProductFilter';
import { siteVisual } from '../../data/satechiSite';
import { products } from '../../data/site';
import { seriesFormats } from '../../data/productReference';
import { polishedProducts } from '../../data/imagePolish';
import CollectionCover from '../../components/satechi-preview/CollectionCover.astro';
import { readCatalogQuery } from '../../lib/catalogQuery';
const initialFilters = readCatalogQuery(Astro.url.searchParams, 'duty', ['All', 'Run', 'Start']);
---
<BaseLayout title="CBB60, CBB61, CBB65 & CD60 Capacitors" description="Compare CBB60, CBB61 and CBB65 run capacitors with CD60 start capacitors by electrical range, case format and connections.">
  <div class="review-product-directory">
    <CollectionCover product title="Motor capacitor series" description="CBB60, CBB61 and CBB65 run capacitors. CD60 for a separately switched starting circuit." image="/images/previews/satechi-inner-20261019/collection-wide.webp" mobileImage="/images/previews/satechi-inner-20261019/collection-mobile.webp" alt="CBB60, CBB61, CBB65 and CD60 motor capacitor formats." />
    <section class="section catalog-section" aria-label="Product series"><div class="container"><ProductFilter client:load compact={useEditorial} initial={initialFilters} items={products.map(({code,slug,shortName,seriesDescription,tagline,function: duty,capacitance,voltage}) => ({code,slug,shortName,seriesDescription,tagline,image:useEditorial ? siteVisual('product-' + code.toLowerCase()) : `/images/reference-20261012/${code.toLowerCase()}-studio.webp`,imageAlt:polishedProducts[code].alt,function:duty,capacitance,voltage}))} /></div></section>
    <section class="section alt catalog-comparison"><div class="container"><h2>Series comparison</h2><p class="small compare-scroll-hint">Swipe horizontally to compare all fields.</p><div class="compare-wrap" role="region" aria-label="Motor capacitor series comparison" tabindex="0"><table class="compare-table"><thead><tr><th scope="col">Series</th><th scope="col">Duty</th><th scope="col">Case format</th><th scope="col">µF</th><th scope="col">VAC</th><th scope="col">Connections</th></tr></thead><tbody>{products.flatMap(p => p.code === 'CBB65' ? [
      <tr><th scope="row"><a class="card-link" href={'/products/' + p.slug + '/#single-run-specifications'}>CBB65 · single</a></th><td>Run</td><td>Metal can</td><td>2–100 µF</td><td>110–450 VAC</td><td>Terminal groups</td></tr>,
      <tr><th scope="row"><a class="card-link" href={'/products/' + p.slug + '/#dual-run-specifications'}>CBB65 · dual</a></th><td>Run</td><td>Metal can</td><td>Published 1+15 to 15+80 µF</td><td>370–450 VAC</td><td>Model-specific terminal groups</td></tr>
    ] : [<tr><th scope="row"><a class="card-link" href={'/products/' + p.slug + '/'}>{p.code}</a></th><td>{p.function}</td><td>{seriesFormats[p.code].case}</td><td>{p.capacitance}</td><td>{p.voltage}</td><td>{seriesFormats[p.code].connections}</td></tr>])}</tbody></table></div></div></section>
    <InquiryCallout><nav aria-label="Selection references"><a class="card-link" href="/resources/read-motor-capacitor-label/">Read the label guide</a><a class="card-link" href="/products/photographs/">Compare sample labels and connections</a></nav></InquiryCallout>
  </div>
</BaseLayout>


