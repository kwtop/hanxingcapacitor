---
import DemoLayout from '../../components/visual-20261014/DemoLayout.astro';
import InquiryCallout from '../../components/InquiryCallout.astro';
import { products, productHref, applications, applicationHref } from '../../data/site';
import { studio, guides, checks, rating, voltage } from '../../components/visual-20261014/demoData';
const heroApp = applications[3];
---
<DemoLayout direction="b" title="B · Material & precision">
  <section class="b-hero"><img src="/images/visual-directions-20261014/dark-capacitors.png" alt="Illustrative dark studio composition of four capacitor samples; no factory or certification claim." width="1774" height="887" fetchpriority="high" /><div class="v-wrap"><div class="b-hero-copy"><h1>The detail<br />behind<br /><em>every start.</em></h1><p>Motor run and start capacitors<br />for equipment manufacturers.</p><a class="v-button" href="/products/">Explore the capacitor series</a></div></div></section>
  <section class="b-products v-section"><div class="v-wrap"><div class="v-heading"><h2>Four series.<br /><em>Two distinct duties.</em></h2><div><p>CBB60, CBB61 and CBB65 support run duty.<br />CD60 is for switched motor-start duty.</p><p class="v-note">Published series ranges are a starting point.<br />Confirm the exact configuration before ordering.</p></div></div><div class="b-product-grid">{products.map(p => <article><a class="b-product-photo" href={productHref(p)}><img src={studio(p.code)} alt={`Illustrative ${p.code} studio sample.`} width="1254" height="1254" /><span>{p.function} duty</span></a><div class="b-product-caption"><div><h3><a href={productHref(p)}>{p.code}</a></h3><p>{p.shortName}</p></div><p class="v-spec">{rating(p.code,p.capacitance)}<br />{voltage(p.code,p.voltage)}</p></div></article>)}</div><p class="v-note v-image-note">Illustrative studio views. <a href="/products/photographs/">See the original sample photographs</a></p></div></section>
  <section class="b-apps v-section"><div class="v-wrap"><div class="v-heading"><h2>Different equipment.<br /><em>The right starting point.</em></h2><a class="v-secondary" href="/applications/">Application selection</a></div><div class="b-app-layout"><a class="b-app-main" href={applicationHref(heroApp)}><img src={heroApp.image} alt={heroApp.imageAlt} width="1200" height={heroApp.imageHeight} /><h3>{heroApp.shortName}</h3></a><div class="b-app-side">{applications.slice(0,3).map(a => <a href={applicationHref(a)}><img src={a.image} alt={a.imageAlt} width="1200" height={a.imageHeight} /><h3>{a.shortName}</h3></a>)}</div></div><p class="v-note v-image-note">Illustrative equipment scenes. The motor circuit determines the capacitor required.</p></div></section>
  <section class="b-selection v-section"><div class="v-wrap"><div class="b-selection-top"><div><h2>Small details.<br /><em>Specific requirements.</em></h2><p>Read the label. Check the fit.<br />Use the model drawing to confirm.</p><div class="b-checks">{checks.map(c => <div><h3>{c.title}</h3><p>{c.detail}</p></div>)}</div></div><figure><img src="/images/home-selected-20261012/selection-guide.webp" alt="Illustrative capacitor selection composition with a caliper and outline drawing." width="1536" height="1024" /></figure></div><nav class="b-guides" aria-label="Selection guides">{guides.map(g => <a href={g.href}>{g.title}</a>)}</nav></div></section>
  <section class="b-evidence v-section"><div class="v-wrap"><div class="v-heading"><h2>A closer look<br /><em>at the source material.</em></h2><p>Original sample photographs and supplied footage.<br />Model-specific records remain an order check.</p></div><div class="b-evidence-grid"><a class="b-film" href="/factory/"><img src="/images/real/film-rolls.jpg" alt="Original supplied footage still of film processing equipment." width="1920" height="1080" /><div><h3>Materials & process</h3><span>View supplied production footage</span></div></a><a class="b-samples" href="/products/photographs/"><img src="/images/real/batch-products.jpg" alt="Original supplied photograph of metal-can capacitor samples." width="2000" height="2000" /><div><h3>Original samples</h3><span>Explore photographs & configurations</span></div></a></div></div></section>
  <InquiryCallout id="demo-b-inquiry" defaultSeries="CBB60" heading="Let's start with your specification." />
</DemoLayout>
