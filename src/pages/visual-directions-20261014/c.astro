---
import DemoLayout from '../../components/visual-20261014/DemoLayout.astro';
import InquiryCallout from '../../components/InquiryCallout.astro';
import { products, productHref, applications, applicationHref } from '../../data/site';
import { studio, guides, checks, rating, voltage } from '../../components/visual-20261014/demoData';
---
<DemoLayout direction="c" title="C · Equipment in focus">
  <section class="c-hero"><div class="v-wrap c-hero-heading"><h1>Small components.<br /><span>Everyday motion.</span></h1><div><p>Motor run and start capacitors<br />for equipment manufacturers.</p><a class="v-button" href="/products/">Find your capacitor series</a></div></div><div class="c-hero-gallery"><a class="c-hero-products" href="/products/"><img src="/images/home-selected-20261012/hero-four-warm-v2.png" alt="Illustrative studio composition showing all four capacitor series." width="1817" height="866" /><span>CBB60 · CBB61 · CBB65 · CD60</span></a><a class="c-hero-equipment" href={applicationHref(applications[0])}><img src={applications[0].image} alt={applications[0].imageAlt} width="1200" height="800" /><span>Explore water pump applications</span></a></div></section>
  <section class="c-apps v-section"><div class="v-wrap"><div class="v-heading"><h2>Start with<br />the equipment.</h2><p>Explore application guidance.<br />Confirm the capacitor from the motor specification.</p></div><div class="c-app-grid">{applications.map((a,i) => <a class={`c-app c-app-${i}`} href={applicationHref(a)}><img src={a.image} alt={a.imageAlt} width="1200" height={a.imageHeight} /><h3>{a.shortName}</h3></a>)}</div><p class="v-note v-image-note">Illustrative equipment images, not customer installations.</p></div></section>
  <section class="c-products v-section"><div class="v-wrap"><div class="v-heading"><h2>Get to know<br />the four series.</h2><div><p>Three run series. One start series.</p><p class="v-note">Ranges describe the series; availability varies by model.</p></div></div><div class="c-product-grid">{products.map(p => <article><a class="c-product-visual" href={productHref(p)}><img src={studio(p.code)} alt={`Illustrative studio photograph based on an original ${p.code} sample.`} width="1254" height="1254" /></a><div class="c-product-info"><h3><a href={productHref(p)}>{p.code}</a></h3><p>{p.shortName}</p><p class="v-spec">{rating(p.code,p.capacitance)}<br />{voltage(p.code,p.voltage)}</p><a class="v-secondary" href={productHref(p)}>View specifications</a></div></article>)}</div><p class="v-note v-image-note">Studio views are illustrative. <a href="/products/photographs/">Compare original sample photographs</a></p><div class="c-checks"><h3>Before choosing</h3>{checks.map(c => <div><h4>{c.title}</h4><p>{c.detail}</p></div>)}</div></div></section>
  <section class="c-evidence v-section"><div class="v-wrap"><div class="v-heading"><h2>See the samples.<br />Look into the process.</h2><a class="v-secondary" href="/factory/">Production & quality information</a></div><div class="c-evidence-grid"><a class="c-evidence-large" href="/products/photographs/"><img src="/images/real/batch-products.jpg" alt="Original photograph of multiple metal-can capacitor samples." width="2000" height="2000" /><h3>Original sample photographs</h3></a><a href="/factory/"><img src="/images/real/film-rolls.jpg" alt="Supplied production footage showing film processing equipment." width="1920" height="1080" /><h3>Material & process footage</h3></a><a href="/factory/packing-and-dispatch/"><img src="/images/real/packing-scene.jpg" alt="Original supplied footage of product boxes at a packing worktable." width="1080" height="1920" /><h3>Packing & dispatch</h3></a></div><p class="v-note v-image-note">Supplied photographs and video stills. Request current model-specific drawings and test records.</p></div></section>
  <section class="c-guides v-section"><div class="v-wrap c-guide-layout"><div><h2>Know what<br />to look for.</h2><nav aria-label="Selection guides">{guides.map(g => <a href={g.href}><h3>{g.title}</h3><p>{g.detail}</p></a>)}</nav></div><figure><img src="/images/home-selected-20261012/selection-guide.webp" alt="Illustrative selection guide with a CBB65 sample, caliper and drawing." width="1536" height="1024" /></figure></div></section>
  <InquiryCallout id="demo-c-inquiry" defaultSeries="CBB60" />
</DemoLayout>
