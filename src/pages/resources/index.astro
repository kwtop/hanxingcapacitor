---
import { isSatechiPreview } from '../../lib/visualPreview';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resourceSections } from '../../data/site';
import { guides, guideHref } from '../../data/guides';
import '../../styles/resource-hubs.css';
import { siteVisual } from '../../data/satechiSite';
import GuideCover from '../../components/satechi-preview/GuideCover.astro';
import FeaturedGuide from '../../components/satechi-preview/FeaturedGuide.astro';
import SiteImage from '../../components/satechi-preview/SiteImage.astro';
import RefinedPhoto from '../../components/satechi-preview/RefinedPhoto.astro';
import {editorialMedia} from '../../data/editorialMedia';
import {coherenceMedia} from '../../data/coherenceMedia';
import {brochureMedia} from '../../data/brochureMedia';
const sectionVisuals: Record<string,string> = {'/resources/articles/':'resources-desk','/buying-guide/':'guide-shipping','/faq/':'resources-faq'};
const featured = ['read-motor-capacitor-label', 'cbb60-vs-cbb61-vs-cbb65', 'motor-capacitor-order-shipment-checklist'].map(slug => guides.find(guide => guide.slug === slug)!);
---
<BaseLayout title="Motor Capacitor Resources | Technical & Buying Guides" description="Motor capacitor selection guides and buying checklists. Read labels, compare series and prepare the specifications and documents for your order.">
  <div class="review-resource-page resource-hub">
    <section class="page-hero"><div class="container"><p class="breadcrumbs"><a href="/">Home</a> / Resources</p><h1>Motor capacitor resources</h1><p class="lead">Check a capacitor specification and prepare the details for your quotation.</p></div></section>
    <div class="container resource-hub-body">
      {isSatechiPreview && <FeaturedGuide guide={featured[0]} />}
      <nav class="resource-hub-routes" aria-label="Resource categories">
        {resourceSections.map(section => <a href={section.href}>{isSatechiPreview && <SiteImage class="ss-resource-cover" src={section.href === '/resources/articles/' ? coherenceMedia.measurement.src : section.href === '/buying-guide/' ? brochureMedia['cbb65-packaging'].src : siteVisual(sectionVisuals[section.href])} alt={section.href === '/resources/articles/' ? coherenceMedia.measurement.alt : section.href === '/faq/' ? editorialMedia['buyer-photo-details'].alt : brochureMedia['cbb65-packaging'].alt} sizes="(max-width:600px) calc(100vw - 32px), 30vw" />}<h2 id={section.href === '/resources/articles/' ? 'resource-electrical' : section.href === '/buying-guide/' ? 'resource-ordering' : undefined}>{section.href === '/resources/articles/' && <><span id="resource-formats" aria-hidden="true"></span><span id="resource-mechanical" aria-hidden="true"></span></>}{section.label}</h2><p>{section.description}</p></a>)}
      </nav>
      <section class="resource-hub-section" aria-labelledby="featured-guides"><h2 id="featured-guides">Selection and order guides</h2><div class="resource-article-list">
        {(isSatechiPreview ? featured.slice(1) : featured).map(guide => <a href={guideHref(guide)}>{isSatechiPreview && <GuideCover class="ss-resource-cover" slug={guide.slug} />}<h3>{guide.title}</h3><p>{guide.summary}</p></a>)}
      </div></section>
      <section class:list={['resource-hub-section',{'ss-documents-band':isSatechiPreview}]}>{isSatechiPreview && <RefinedPhoto name="label-carton" />}<div><h2 id="resource-records">Company and model documents</h2><nav class="resource-hub-actions" aria-label="Company and model documents"><a class="card-link" href="/about/#supplier-records">Company information</a><a class="card-link" href="/factory/#model-records">Product document checklist</a></nav></div></section>
    </div>
  </div>
</BaseLayout>
