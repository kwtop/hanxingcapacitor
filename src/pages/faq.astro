---
import BaseLayout from '../layouts/BaseLayout.astro';
import {isSatechiPreview} from '../lib/visualPreview';
import RefinedPhoto from '../components/satechi-preview/RefinedPhoto.astro';
import DirectorySearch from '../components/DirectorySearch.astro';
const orderGuide = '/resources/motor-capacitor-order-shipment-checklist/';
const questions = [
  { question: 'What is the minimum order quantity?', answer: 'The standard minimum is 1,000 pieces. Record the minimum for your model and configuration in the quotation.', next: { label: 'Ask about your model and quantity', href: '/contact/?request=quote#inquiry-form' } },
  { question: 'Can I order custom labels or connections?', answer: 'Send the artwork, connection drawing, packing requirements and quantity for a configuration quotation. Keep the approved revisions with the order.', next: { label: 'OEM requirements and sample approval', href: '/oem/' } },
  { question: 'Which photos should I send?', answer: 'Send the full capacitor label, terminal end, side and mounting views, plus the motor plate. Add the photos to your email or WhatsApp message.', next: { label: 'Use the quotation checklist', href: '/buying-guide/#rfq-template' } },
  { question: 'Which capacitor series should I choose?', answer: 'Use the original label and motor diagram to identify run or start duty. Then match the ratings, connection layout and installation dimensions.', next: { label: 'Compare capacitor series', href: '/resources/cbb60-vs-cbb61-vs-cbb65/' } },
  { question: 'Is every rating in a series range available?', answer: 'No. A series range covers several configurations. Request the exact rating, case size and connections in your model quotation.', next: { label: 'Prepare a model quotation request', href: '/buying-guide/#rfq-template' } },
  { question: 'Can a start capacitor replace a run capacitor?', answer: 'No. Start and run capacitors have different circuit duties, even when their µF values or case sizes match. Follow the duty and switching arrangement specified by the motor manufacturer.', next: { label: 'Compare start and run duty', href: '/resources/start-vs-run-capacitors/' } },
  { question: 'What details are needed for a dual-run quotation?', answer: 'Record both independent µF values and the rated VAC, with the equipment model. Include the can and mounting dimensions and a photo or drawing of the terminal groups. State the quantity required.', next: { label: 'Single-run and dual-run specifications', href: '/resources/single-vs-dual-run-capacitors/' } },
  { question: 'Does one certificate cover every model?', answer: 'No. Each certificate lists its covered models, scope and validity. Request the document for your selected model and destination market.', next: { label: 'Model documents and certificate checks', href: '/factory/#model-records' } },
  { question: 'What should I check before dispatch?', answer: 'Check the model and drawing revision against the approved order, then compare quantities, labels and packing. Review the inspection reports and shipping documents before carrier handover.', next: { label: 'Dispatch and inspection checklist', href: `${orderGuide}#3-record-dispatch-dates-and-checks` } },
  { question: 'Which shipping documents should I request?', answer: 'Agree the required invoice, packing list and transport record in the order. Confirm any additional documents for the destination; the route and contract determine the requirements.', next: { label: 'Shipping document checklist', href: `${orderGuide}#4-check-documents-against-the-shipping-route` } },
  { question: 'How should lead time and delivery dates be confirmed?', answer: 'Keep separate dates for production completion, inspection release, carrier pickup, departure and estimated arrival. Agree who will provide updates, report delays and approve partial shipments.', next: { label: 'Production and shipping dates', href: `${orderGuide}#3-record-dispatch-dates-and-checks` } },
];
const questionGroups = [
  { id: 'inquiry', title: 'Quotations and custom orders', questions: [0, 1, 2] },
  { id: 'selection', title: 'Selecting a capacitor', questions: [3, 4, 5, 6, 7] },
  { id: 'orders', title: 'Orders and shipping', questions: [8, 9, 10] },
];
---
<BaseLayout title="Motor Capacitor Buyer FAQ" description="Answers to capacitor buying questions about minimum quantities, custom labels, model selection, certificate checks, lead times and shipping documents.">
  <div class="review-faq-page"><section class="page-hero compact-page-hero"><div class="container"><p class="breadcrumbs"><a href="/">Home</a> / <a href="/resources/">Resources</a> / Buyer FAQ</p>{isSatechiPreview ? <div class="ss-faq-intro"><div><h1>Motor capacitor buying questions</h1><p class="ss-media-lead">Answers about model selection, minimum quantities, custom orders and shipping.</p><nav class="ss-faq-jump" aria-label="Question topics"><a class="card-link" href="#faq-inquiry">Quotations</a><a class="card-link" href="#faq-selection">Model selection</a><a class="card-link" href="#faq-orders">Orders &amp; shipping</a></nav></div><RefinedPhoto name="buyer-photo-details" eager /></div> : <h1>Motor capacitor buying questions</h1>}</div></section>
    <section class="section"><div class="container faq review-faq-list"><DirectorySearch directory="buyer-questions" label="Search buying questions" placeholder="e.g. minimum order or shipping" noun="questions" emptyTitle="No matching questions" /><div id="buyer-questions" data-content-directory>{questionGroups.map(group => <section class="faq-group" data-search-group aria-labelledby={`faq-${group.id}`}><h2 id={`faq-${group.id}`}>{group.title}</h2>{group.questions.map((index) => <details data-search-item><summary>{questions[index].question}</summary><p>{questions[index].answer}</p><a class="card-link faq-next-step" href={questions[index].next.href}>{questions[index].next.label}</a></details>)}</section>)}</div></div></section>
  </div>
</BaseLayout>
