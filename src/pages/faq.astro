---
import BaseLayout from '../layouts/BaseLayout.astro';
const orderGuide = '/resources/motor-capacitor-order-shipment-checklist/';
const questions = [
  { question: 'What is the minimum order quantity?', answer: 'The standard minimum is 1,000 pieces. Confirm the minimum for your exact model and configuration in the quotation.', next: { label: 'Ask about your model and quantity', href: '/contact/?request=quote#inquiry-form' } },
  { question: 'Can I order custom labels or connections?', answer: 'Send the label artwork and connection details, with your packing requirements and quantity. Availability and the versions approved for your order need confirmation in the written quotation.', next: { label: 'OEM requirements and sample approval', href: '/oem/' } },
  { question: 'Which photos should I send?', answer: 'Send clear photos of the full capacitor label and terminal end. Include side and mounting views, plus the motor plate. Attach the photos in your email or WhatsApp app before sending your message.', next: { label: 'Use the quotation checklist', href: '/buying-guide/#rfq-template' } },
  { question: 'Which capacitor series should I choose?', answer: 'Start with the original label and motor wiring diagram to identify run or start duty. Match the electrical ratings, then check the connections and installation space. The equipment name alone cannot identify a suitable model.', next: { label: 'Compare capacitor series', href: '/resources/cbb60-vs-cbb61-vs-cbb65/' } },
  { question: 'Is every rating in a series range available?', answer: 'No. A series range describes overall limits, not every combination of rating, case size and connections. Request a drawing and quotation for the exact configuration you need.', next: { label: 'Prepare a model quotation request', href: '/buying-guide/#rfq-template' } },
  { question: 'Can a start capacitor replace a run capacitor?', answer: 'No. Start and run capacitors have different circuit duties, even when their µF values or case sizes match. Follow the duty and switching arrangement specified by the motor manufacturer.', next: { label: 'Compare start and run duty', href: '/resources/start-vs-run-capacitors/' } },
  { question: 'What details are needed for a dual-run quotation?', answer: 'Record both independent µF values and the rated VAC, with the equipment model. Include the can and mounting dimensions and a photo or drawing of the terminal groups. State the quantity required.', next: { label: 'Single-run and dual-run specifications', href: '/resources/single-vs-dual-run-capacitors/' } },
  { question: 'Does one certificate cover every model?', answer: 'No. Check the models listed on the certificate, along with its scope and validity. Model certificates are not published on this site; request the relevant document for your model and destination market.', next: { label: 'Model documents and certificate checks', href: '/factory/#model-records' } },
  { question: 'What should I check before dispatch?', answer: 'Check the model and drawing revision against the approved order, then compare quantities, labels and packing. Review the inspection reports and shipping documents before carrier handover.', next: { label: 'Dispatch and inspection checklist', href: `${orderGuide}#3-record-dispatch-dates-and-checks` } },
  { question: 'Which shipping documents should I request?', answer: 'Agree the required invoice, packing list and transport record in the order. Confirm any additional documents for the destination; the route and contract determine the requirements.', next: { label: 'Shipping document checklist', href: `${orderGuide}#4-check-documents-against-the-shipping-route` } },
  { question: 'Can I see records of previous capacitor shipments?', answer: 'This site does not yet publish shipment records. Ask whether an anonymized example is available, and agree the inspection and carrier-handover records you need for your own order.', next: { label: 'Carrier handover checklist', href: '/factory/packing-and-dispatch/#handover' } },
  { question: 'How should lead time and delivery dates be confirmed?', answer: 'Keep separate dates for production completion, inspection release, carrier pickup, departure and estimated arrival. Agree who will provide updates, report delays and approve partial shipments.', next: { label: 'Production and shipping dates', href: `${orderGuide}#3-record-dispatch-dates-and-checks` } },
];
const questionGroups = [
  { id: 'inquiry', title: 'Quotations and custom orders', questions: [0, 1, 2] },
  { id: 'selection', title: 'Selecting a capacitor', questions: [3, 4, 5, 6, 7] },
  { id: 'orders', title: 'Orders and shipping', questions: [8, 9, 10, 11] },
];
---
<BaseLayout title="Motor Capacitor Buyer FAQ" description="Answers to capacitor buying questions about minimum quantities, custom labels, model selection, certificate checks, lead times and shipping documents.">
  <div class="review-faq-page"><section class="page-hero compact-page-hero"><div class="container"><p class="breadcrumbs"><a href="/">Home</a> / <a href="/resources/">Resources</a> / Buyer FAQ</p><h1>Motor capacitor buying questions</h1></div></section>
    <section class="section"><div class="container faq review-faq-list">{questionGroups.map(group => <section class="faq-group" aria-labelledby={`faq-${group.id}`}><h2 id={`faq-${group.id}`}>{group.title}</h2>{group.questions.map((index) => <details><summary>{questions[index].question}</summary><p>{questions[index].answer}</p><a class="card-link faq-next-step" href={questions[index].next.href}>{questions[index].next.label}</a></details>)}</section>)}</div></section>
  </div>
</BaseLayout>
