---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/resource-editorial.css';
import { usesEditorialPresentation } from '../lib/visualPreview';
const useEditorial = usesEditorialPresentation(Astro.url.pathname);
import RefinedPhoto from '../components/satechi-preview/RefinedPhoto.astro';
import DirectorySearch from '../components/DirectorySearch.astro';
import { buyerQuestions as questions } from '../data/buyerQuestions';
const questionGroups = [
  { id: 'inquiry', title: 'Quotations and ordering' },
  { id: 'selection', title: 'Selection and materials' },
  { id: 'documents', title: 'Documents and quality' },
  { id: 'orders', title: 'Packing, delivery and after-sales' },
];
---
<BaseLayout title="Motor Capacitor Buyer FAQ" description="Answers about motor capacitor MOQ, free test samples, warranty, payment, OEM and ODM requirements, materials, model documents and shipping.">
  <div class="review-faq-page resource-suite"><section class="page-hero compact-page-hero"><div class="container"><p class="breadcrumbs"><a href="/">Home</a> / <a href="/resources/">Resources</a> / Buyer FAQ</p>{useEditorial ? <div class="ss-faq-intro"><div><h1>Motor capacitor buying questions</h1><p class="ss-media-lead">Check model selection, mixed-model orders, samples, documents and delivery terms before placing your order.</p></div><RefinedPhoto name="buyer-photo-details" eager /></div> : <h1>Motor capacitor buying questions</h1>}</div></section>
    <section class="section"><div class="container faq review-faq-list"><DirectorySearch directory="buyer-questions" label="Search buying questions" placeholder="e.g. MOQ, warranty or payment" noun="questions" emptyTitle="No matching questions" /><div id="buyer-questions" data-content-directory>{questionGroups.map(group => <section class="faq-group" data-search-group aria-labelledby={`faq-${group.id}`}><h2 id={`faq-${group.id}`}>{group.title}</h2>{questions.filter(question => question.group === group.id).map(question => <details id={`question-${question.id}`} data-search-item><summary>{question.question}</summary><p>{question.answer}</p><a class="card-link faq-next-step" href={question.next.href}>{question.next.label}</a></details>)}</section>)}</div></div></section>
  </div>
</BaseLayout>
