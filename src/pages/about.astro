---
import { usesEditorialPresentation } from '../lib/visualPreview';
const useEditorial = usesEditorialPresentation(Astro.url.pathname);
import AboutStory from '../components/satechi-preview/AboutStory.astro';
import EditorialVisual from '../components/satechi-preview/EditorialVisual.astro';
import FactoryMedia from '../components/satechi-preview/FactoryMedia.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryCallout from '../components/InquiryCallout.astro';
import AboutVisitGallery from '../components/sunday/AboutVisitGallery.astro';
import { PUBLIC_BRAND_NAME, PUBLIC_HEADQUARTERS_ADDRESS, PUBLIC_FACTORY_ADDRESS, PUBLIC_COMPANY_RELATIONSHIP, PUBLIC_COMPANY_NAME, PUBLIC_EMAIL, PUBLIC_PHONE, WHATSAPP_URL } from '../data/site';
---
<BaseLayout title="About HAN XING | Company & Contact Information" description="HAN XING is the capacitor brand of Hangzhou Zebang, with headquarters in Hangzhou and manufacturing in Hebei. View company details and sales contacts.">
  {useEditorial ? <AboutStory /> : <article class="procurement-page procurement-about">
    <section class="procurement-hero"><div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / About</p>
      <h1>About HAN XING</h1>
      <p class="procurement-lead">{PUBLIC_COMPANY_RELATIONSHIP}</p>
      <nav class="procurement-actions" aria-label="Company information"><a class="card-link" href="/contact/">Contact Hanxing</a></nav>
      {useEditorial && <EditorialVisual name="brand-story" alt="CBB60, CBB61, CBB65 and CD60 capacitor case and connection formats." eager />}
    </div></section>
    <section class="procurement-section procurement-company-information" id="supplier-records"><div class="container">
      <h2>Company information</h2>
      <dl class="procurement-company-records"><div><dt>Head company</dt><dd>{PUBLIC_COMPANY_NAME}</dd></div><div><dt>Brand</dt><dd>{PUBLIC_BRAND_NAME} / Hanxing Capacitor</dd></div><div><dt>Headquarters — Hangzhou</dt><dd>{PUBLIC_HEADQUARTERS_ADDRESS}</dd></div><div><dt>Manufacturing facility — Hebei</dt><dd>{PUBLIC_FACTORY_ADDRESS}</dd></div><div><dt>Email</dt><dd><a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a></dd></div><div><dt>WhatsApp</dt><dd><a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">{PUBLIC_PHONE}</a></dd></div></dl>
    </div></section>
    <section class="procurement-section"><div class="container procurement-company-story">
      <div><h2>Motor capacitor supply</h2><p>The range includes CBB60, CBB61 and CBB65 run capacitors and CD60 start capacitors for pumps, fans, refrigeration and other single-phase motor circuits.</p><a class="card-link" href="/oem/">OEM requirements and approval</a></div>
      {useEditorial ? <FactoryMedia name="batch" class="procurement-company-photo" /> : <figure class="procurement-company-photo"><img src="/images/real/batch-products.jpg" alt="HAN XING capacitor samples grouped on a work surface." width="1920" height="1080" loading="lazy" /></figure>}
    </div></section>
    <AboutVisitGallery />
    <InquiryCallout><nav aria-label="Product records"><a class="card-link" href="/factory/#model-records">Documents for your model</a><a class="card-link" href="/products/">Explore the capacitor series</a></nav></InquiryCallout>
  </article>}
</BaseLayout>
