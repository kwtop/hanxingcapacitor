---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryCallout from '../components/InquiryCallout.astro';
import { PUBLIC_BUSINESS_ADDRESS, PUBLIC_COMPANY_NAME, PUBLIC_EMAIL, PUBLIC_PHONE, WHATSAPP_URL } from '../data/site';
---
<BaseLayout title="About HAN XING | Company & Contact Information" description="HAN XING motor capacitor series, company and contact details, with email, WhatsApp and supplier identity information for buyers.">
  <article class="procurement-page procurement-about">
    <section class="procurement-hero"><div class="container">
      <p class="breadcrumbs"><a href="/">Home</a> / About</p>
      <h1>About HAN XING</h1>
      <nav class="procurement-actions" aria-label="Supplier information"><a class="card-link" href="#supplier-records">Supplier identity</a><a class="card-link" href="/contact/">Contact Hanxing</a></nav>
    </div></section>
    <section class="procurement-section procurement-company-information"><div class="container">
      <h2>Company information</h2>
      <dl class="procurement-company-records"><div><dt>Company name</dt><dd>{PUBLIC_COMPANY_NAME}</dd></div><div><dt>Brand</dt><dd>Hanxing Capacitor / HAN XING</dd></div><div><dt>Business address</dt><dd>{PUBLIC_BUSINESS_ADDRESS}</dd></div><div><dt>Email</dt><dd><a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a></dd></div><div><dt>WhatsApp</dt><dd><a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">{PUBLIC_PHONE}</a></dd></div></dl>
    </div></section>
    <section class="procurement-section" id="supplier-records"><div class="container">
      <h2>Supplier identity for your order</h2>
      <div class="procurement-readable"><p>Confirm the legal seller, manufacturer and their relationship to the HAN XING brand in the written quotation and contract.</p></div>
    </div></section>
    <section class="procurement-section"><div class="container procurement-company-story">
      <div><h2>Motor capacitor supply</h2><p>CBB60, CBB61 and CBB65 run capacitors; CD60 start capacitors. For pumps, fans, refrigeration and other single-phase motors, selected to the motor specification.</p><a class="card-link" href="/oem/">OEM requirements and approval</a></div>
      <figure class="procurement-company-photo"><img src="/images/real/batch-products.jpg" alt="Hanxing-marked capacitor samples on a work surface in a supplied photograph." width="1920" height="1080" loading="lazy" /></figure>
    </div></section>
    <InquiryCallout><nav aria-label="Product records"><a class="card-link" href="/factory/#model-records">Documents for your model</a><a class="card-link" href="/products/">Explore the capacitor series</a></nav></InquiryCallout>
  </article>
</BaseLayout>
