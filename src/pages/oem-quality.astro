---
import BaseLayout from '../layouts/BaseLayout.astro';
import OemPageHero from '../components/sunday/OemPageHero.astro';
import OemReading from '../components/sunday/OemReading.astro';
import OemPhotography from '../components/sunday/OemPhotography.astro';
import OemWorkshopImage from '../components/sunday/OemWorkshopImage.astro';
import '../styles/oem-editorial.css';
const reading=[
 {title:'Approve an OEM sample',description:'Link the sample to its drawing, electrical specification and artwork revision.',href:'/resources/oem-capacitor-sample-approval/'},
 {title:'Prepare a quotation',description:'Ratings, connection details, quantities and destination in one inquiry.',href:'/buying-guide/#rfq-template'},
 {title:'Plan the shipment',description:'Packing quantities, delivery terms and the records for carrier handover.',href:'/resources/motor-capacitor-order-shipment-checklist/'}
];
---
<BaseLayout title="Motor Capacitor OEM, Manufacturing & Quality" description="OEM labels and packaging for motor capacitors, workshop footage, model document requests and packing information for CBB60, CBB61, CBB65 and CD60 orders.">
  <article class="oem-suite oe-hub">
    <OemPageHero title="OEM and quality" description="Private-label motor capacitors, sample approval, model documents and packing requirements for your order." current="OEM & quality" layout="text" />
    <div class="oe-shell oe-hub-grid">
      <section class="oe-hub-card" id="oem-supply" aria-labelledby="oem-supply-title">
        <a href="/oem/">
          <div class="oe-hub-photo"><OemPhotography name="oem-lineup" eager sizes="(max-width:700px) calc(100vw - 40px), (min-width:1360px) 620px, 46vw" /></div>
          <div class="oe-hub-card-copy"><h2 id="oem-supply-title">OEM and private label</h2><p>CBB60, CBB61, CBB65 and CD60 with your label and packaging. Electrical or structural changes are quoted for the specific model.</p><span class="oe-hub-action">Explore OEM requirements</span></div>
        </a>
      </section>
      <section class="oe-hub-card" id="quality-workshop-views" aria-labelledby="quality-workshop-views-title">
        <a href="/factory/">
          <div class="oe-hub-photo"><OemWorkshopImage name="film-floor" eager sizes="(max-width:700px) calc(100vw - 40px), (min-width:1360px) 620px, 46vw" /></div>
          <div class="oe-hub-card-copy"><h2 id="quality-workshop-views-title">Manufacturing and quality</h2><p>Film processing, component handling and the test area, with a guide to the model references, test conditions and results needed in an inspection report.</p><span class="oe-hub-action">View manufacturing and records</span></div>
        </a>
      </section>
      <section class="oe-hub-card" id="process-gallery" aria-labelledby="process-gallery-title">
        <a href="/factory/process-gallery/">
          <div class="oe-hub-photo"><OemWorkshopImage name="09-assembly-machine" sizes="(max-width:700px) calc(100vw - 40px), (min-width:1360px) 620px, 46vw" /></div>
          <div class="oe-hub-card-copy"><h2 id="process-gallery-title">Inside the workshop</h2><p>Equipment, can assembly, packing and loading in the workshop gallery.</p><span class="oe-hub-action">Explore the process gallery</span></div>
        </a>
      </section>
      <section class="oe-hub-card" id="packing-dispatch" aria-labelledby="packing-dispatch-title">
        <a href="/factory/packing-and-dispatch/">
          <div class="oe-hub-photo"><OemWorkshopImage name="25-packing-worker" sizes="(max-width:700px) calc(100vw - 40px), (min-width:1360px) 620px, 46vw" /></div>
          <div class="oe-hub-card-copy"><h2 id="packing-dispatch-title">Packing and dispatch</h2><p>Protection for capacitor bodies, leads and terminals, plus carton quantities, shipping marks and carrier handover records.</p><span class="oe-hub-action">Plan packing and dispatch</span></div>
        </a>
      </section>
    </div>
    <OemReading title="Before placing an order" links={reading} />
  </article>
</BaseLayout>
