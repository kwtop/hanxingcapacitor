---
import type { Application } from '../data/site';
import { applicationHref } from '../data/site';
import { usesEditorialPresentation } from '../lib/visualPreview';
const useEditorial = usesEditorialPresentation(Astro.url.pathname);
import { applicationVisuals } from '../data/satechiSite';
import { industrialApplications } from '../data/industrialApplications';
import SiteImage from './satechi-preview/SiteImage.astro';
interface Props { application: Application }
const { application } = Astro.props;
---
<article class="card app-card"><figure class="application-card-image"><a href={applicationHref(application)} aria-label={'View ' + application.shortName + ' application'}><SiteImage src={useEditorial ? applicationVisuals[application.slug] : application.image} alt={useEditorial ? industrialApplications[application.slug].alt : application.imageAlt} width={useEditorial ? 1536 : 1200} height={useEditorial ? 1024 : application.imageHeight} sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 1440px) calc((100vw - 120px) / 2), 680px" /></a></figure><div class="card-body"><h2 class="card-title"><a href={applicationHref(application)}>{application.shortName}</a></h2><p class="application-series">{application.listing}</p></div></article>
