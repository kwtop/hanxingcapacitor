---
import type { Application } from '../data/site';
import { applicationHref } from '../data/site';
interface Props { application: Application }
const { application } = Astro.props;
---
<article class="card app-card"><figure class="application-card-image"><a href={applicationHref(application)} aria-label={'View ' + application.shortName + ' application'}><img src={application.image} alt={application.imageAlt} width="1200" height={application.imageHeight} loading="lazy" /></a></figure><div class="card-body"><h2 class="card-title"><a href={applicationHref(application)}>{application.shortName}</a></h2><p class="application-series">{application.listing}</p><a class="card-link" href={applicationHref(application)}>View details <span aria-hidden="true">→</span></a></div></article>
