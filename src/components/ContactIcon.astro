---
interface Props { name: 'email' | 'whatsapp' | 'location' | 'wechat' | 'qr' | 'facebook' | 'instagram'; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg class={`contact-icon contact-icon--${name}`} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
  {name === 'email' && <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></g>}
  {name === 'whatsapp' && <><path fill="currentColor" d="M20.6 11.8a8.6 8.6 0 0 1-12.8 7.5L3 20.6l1.3-4.7A8.6 8.6 0 1 1 20.6 11.8Z" /><path fill="#fff" d="M8.1 7.5c-.5.6-.6 1.3-.3 2.1 1 2.7 3 4.7 5.7 5.7.8.3 1.5.2 2.1-.3l.9-1-2.3-1.2-.8.8c-1.6-.7-2.8-1.9-3.5-3.5l.8-.8-1.2-2.3Z" /></>}
  {name === 'location' && <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></g>}
  {name === 'wechat' && <>
    <path fill="currentColor" d="M9 3.5C4.9 3.5 1.5 6.2 1.5 9.6c0 1.8.9 3.3 2.4 4.4l-.6 2.4 2.8-1.4c.9.4 1.9.6 2.9.6 4.1 0 7.5-2.7 7.5-6S13.1 3.5 9 3.5Z" />
    <path fill="currentColor" stroke="var(--contact-icon-cutout, white)" stroke-width="1" d="M16.1 10.4c-3.5 0-6.4 2.3-6.4 5.3s2.9 5.3 6.4 5.3c.9 0 1.7-.1 2.5-.4l2.3 1.2-.5-2.1c1.3-1 2.1-2.4 2.1-4 0-3-2.9-5.3-6.4-5.3Z" />
    <g fill="var(--contact-icon-cutout, white)"><circle cx="6.5" cy="8.5" r=".9" /><circle cx="11.5" cy="8.5" r=".9" /><circle cx="14" cy="14.8" r=".8" /><circle cx="18.3" cy="14.8" r=".8" /></g>
  </>}
  {name === 'qr' && <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M3.5 3.5h6v6h-6zM14.5 3.5h6v6h-6zM3.5 14.5h6v6h-6zM14.5 14.5h3v3h-3zM20.5 14.5v2m0 3v1h-3m-3 0h.5" />}
  {name === 'facebook' && <path fill="currentColor" d="M13.7 21v-8.2h2.8l.4-3.2h-3.2v-2c0-.9.3-1.6 1.6-1.6H17V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.5v3.2h2.8V21h3.4Z" />}
  {name === 'instagram' && <><g fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /></g><circle fill="currentColor" cx="17.3" cy="6.8" r="1" /></>}
</svg>
<style>
  .contact-icon { flex-shrink: 0; vertical-align: middle; }
  .contact-icon--whatsapp, .contact-icon--wechat { color: #25d366; }
</style>
