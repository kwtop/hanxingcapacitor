---
import ProductReferenceGallery from './ProductReferenceGallery';
import InquiryCallout from './InquiryCallout.astro';
import { isSatechiPreview } from '../lib/visualPreview';
import { siteVisual } from '../data/satechiSite';
import { polishedProducts } from '../data/imagePolish';
import { type Product } from '../data/site';
import { productReference, seriesFormats, type ReferenceGalleryPhoto } from '../data/productReference';
import { sampleConfigurations } from '../data/sampleConfigurations';
import SampleEvidence from './SampleEvidence.astro';
import '../styles/product-reference.css';
import ProductStory from './satechi-preview/ProductStory.astro';
import BrochurePhoto from './satechi-preview/BrochurePhoto.astro';
import ConnectionFormats from './satechi-preview/ConnectionFormats.astro';
import ProductOrderDetails from './ProductOrderDetails.astro';
import ProductSpecifications from './ProductSpecifications.astro';
import { applicationVisuals } from '../data/satechiSite';
interface Props { product: Product; photos: ReferenceGalleryPhoto[]; others: Product[]; }
const { product, photos, others } = Astro.props;
const { code } = product;
const content = productReference[code];
const applicationImage = applicationVisuals[code === 'CBB60' ? 'pumps-and-water-systems' : code === 'CBB61' ? 'fans-and-ventilation' : 'hvac-and-refrigeration'];
const samples = sampleConfigurations.filter(sample => sample.series === code);
const rfq = '/contact/?series=' + code + '&request=quote#inquiry-form';
const sampleChecks: Record<string, string[]> = {
  'cbb60-stud': ['Measure the body diameter and height separately from the base stud.', 'Include stud and fixing dimensions, lead length and clearance around the installed leads.'],
  'cbb61-blades': ['Include case L / W / H, blade spacing and fixing positions on the drawing.'],
  'cbb61-leads': ['Include lead exit, length, connector and mounting-tab positions on the drawing.'],
  'cbb65-single': ['Allow room above the terminals as well as around the can and mounting hardware.'],
  'cbb65-dual': [],
  'cd60-start': ['Include body dimensions, terminal or lead connections and installed clearance on the drawing.'],
};
const documents = [
  ['Current datasheet', 'Exact model number and revision, µF, VAC, tolerance, frequency and operating temperature.'],
  ['Dimensioned drawing & revision', content.documentDimensions + ' ' + content.documentConnections],
  ['Duty information', content.documentDuty + (code === 'CD60' ? ' Confirm permitted start duration and repeat-start cycle.' : '')],
  ['Test reports & certificates', 'Model and destination coverage, issuer, certificate or report number, and validity.'],
];
---
<article class="pdr-reference" data-series={code}>
  <div class="pdr-wrap">
    <section class="pdr-hero" aria-labelledby="pdr-title">
      <nav class="pdr-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span><span aria-current="page">{code}</span></nav>
      <div class="pdr-hero-copy">
        <h1 id="pdr-title">{code}<br />{code === 'CBB65' ? 'single & dual-run capacitors' : product.title.slice(code.length).trim()}</h1>
        {isSatechiPreview && <p class="pdr-hero-summary">{product.tagline}</p>}
        <dl class="pdr-key-facts">
          <div class="pdr-duty-fact"><dt>Duty</dt><dd>{product.function}<small>{content.dutyContext}</small></dd></div>
          {code === 'CBB65' ? <>
            <div><dt>Single run</dt><dd>2–100 µF<small>110–450 VAC</small></dd></div>
            <div><dt>Dual run</dt><dd>1+15 to 15+80 µF<small>370–450 VAC</small></dd></div>
          </> : <><div><dt>Capacitance range</dt><dd>{product.capacitance}</dd></div><div><dt>Rated voltage</dt><dd>{product.voltage}</dd></div></>}
        </dl>
        {code === 'CD60' && <p class="pdr-hero-scope">The circuit must disconnect CD60 after startup. Follow the rated starting time and interval between starts.</p>}
        <a class="pdr-button" href={rfq}>Request a {code} quote</a>
      </div>
      <ProductReferenceGallery client:load photos={photos} code={code} display={isSatechiPreview ? {src:siteVisual('product-' + code.toLowerCase()),alt:`Studio illustration of a ${code} capacitor.`} : undefined} />
    </section>

    {isSatechiPreview && <>
      <!-- Keep the series study separate from the original sample gallery. -->
      <ProductStory product={product} />
    </>}

    <ProductSpecifications product={product} />

    <section class="pdr-section" id="sample-configurations">
      <h2>Sample configurations & fit</h2>
      {isSatechiPreview && code === 'CBB60' && <ConnectionFormats />}
      <SampleEvidence series={code} />
      <div class:list={['pdr-sample-configurations', { 'pdr-sample-pair': samples.length > 1 }]}>{samples.map(sample => {
        const reference = photos.find(photo => photo.src === sample.image);
        return <div class="pdr-sample-configuration"><figure><div class="pdr-detail-photo"><img src={sample.image} alt={code + ': ' + sample.name + '. ' + sample.connection + '.'} width="2000" height="2000" loading="lazy" /></div>{code !== 'CBB60' && reference?.id && <figcaption>{reference.id}</figcaption>}</figure><div class="pdr-sample-copy"><h3>{sample.name}</h3><dl><div><dt>Visible markings</dt><dd>{sample.rating}</dd></div><div><dt>Connection / fixing</dt><dd>{sample.connection}</dd></div></dl>{sampleChecks[sample.id].length > 0 && <ul>{sampleChecks[sample.id].map(check => <li>{check}</li>)}</ul>}</div></div>;
      })}</div>
      <div class="pdr-fit-record"><div class="pdr-fit-actions"><a class="pdr-text-link" href="/resources/dimensions-terminals-mounting/">Dimensions & connection guide</a></div></div>
    </section>

    {isSatechiPreview ? <section class="pdr-section ss-product-applications" id="pdr-applications"><figure><img src={applicationImage} alt="Illustration of equipment using motor capacitors." width="1536" height="1024" loading="lazy" /></figure><div><h2>Applications</h2><ul class="pdr-applications">{content.applications.map(application => <li><h3>{application.href ? <a href={application.href}>{application.title}</a> : application.title}</h3><p>{application.examples}</p></li>)}</ul><p class="pdr-note"><a href={product.decisionGuide.href}>{product.decisionGuide.label}</a></p></div></section> : <section class="pdr-section" id="pdr-applications"><h2>Applications</h2><ul class="pdr-applications">{content.applications.map(application => <li><h3>{application.href ? <a href={application.href}>{application.title}</a> : application.title}</h3><p>{application.examples}</p></li>)}</ul><p class="pdr-note"><a href={product.decisionGuide.href}>{product.decisionGuide.label}</a></p></section>}

    <section class="pdr-section pdr-document-section" id="model-documents">
      <div class="pdr-document-intro"><h2>{code} datasheets &amp; drawings</h2><p>Include the model configuration and destination when requesting these documents.</p><div class="pdr-resource-actions"><a class="pdr-button" href={'/contact/?series=' + code + '&request=documents#inquiry-form'}>Request model documents</a><a class="pdr-secondary" href="/factory/#model-records">Document checklist</a></div></div>
      <dl class="pdr-document-list">{documents.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
    </section>

    <section class:list={['pdr-section', {'pdr-purchasing--pictured': isSatechiPreview && code === 'CBB65'}]} id="pdr-purchasing"><h2>Ordering &amp; samples</h2>
      {isSatechiPreview && code === 'CBB65' ? <div class="zi-purchase-layout"><BrochurePhoto name="cbb65-packaging" zoom label="CBB65 product and packaging" sizes="(max-width: 800px) calc(100vw - 32px), 46vw" /><div><ProductOrderDetails /></div></div> : <ProductOrderDetails />}
    </section>

    <InquiryCallout id="prepare-rfq" contained href={rfq} defaultSeries={code} heading={`Request a ${code} quote`} description="Send the original part reference and the quantity you need." buttonLabel={`Prepare a ${code} inquiry`}><ul><li>Motor model and capacitor label or specification</li><li>Drawing or measurements for the case, mounting and connections</li>{code === 'CD60' && <li>Starting circuit, switching arrangement and duty limits</li>}<li>Quantity by rating and destination</li></ul><a class="card-link" href="/buying-guide/#rfq-template">Quotation checklist</a></InquiryCallout>

    <section class="pdr-related"><h2>Other capacitor series</h2><div class="pdr-related-grid">{others.map(p => <a href={'/products/' + p.slug + '/'}><img src={isSatechiPreview ? polishedProducts[p.code].thumb : p.image} alt={isSatechiPreview ? `Studio illustration of a ${p.code} capacitor.` : p.imageAlt} width="240" height="360" loading="lazy" /><div><h3>{p.code}</h3><p>{p.function} duty · {seriesFormats[p.code].case}</p></div></a>)}</div></section>
  </div>
</article>
<style>
 .pdr-reference .pdr-series-scope{max-width:68ch!important}
</style>

