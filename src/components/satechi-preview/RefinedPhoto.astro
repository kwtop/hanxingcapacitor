---
import {sundayIndustrial} from '../../data/sundayIndustrial';
import {type EditorialMediaName} from '../../data/editorialMedia';
import {originalFactoryVisuals} from '../../data/factoryVisuals';
import SiteImage from './SiteImage.astro';
interface Props { name:EditorialMediaName; class?:string; eager?:boolean; sizes?:string; }
const {name,class:className='',eager=false,sizes}=Astro.props;
const isPacking=/packing|shipping|carton|dispatch/.test(name);
const isConnection=/oem|connection/.test(name);
const image=name === 'quality-process-detail' ? originalFactoryVisuals.workshop : isPacking ? sundayIndustrial.packing : isConnection ? sundayIndustrial.connections : sundayIndustrial.technical;
---
<figure class:list={['ss-refined-photo',className]} data-editorial-media={name} data-documentary={name === 'quality-process-detail' ? 'true' : undefined}>
  <SiteImage src={image.src} alt={image.alt} width={image.width} height={image.height} sizes={sizes} eager={eager} />
</figure>
