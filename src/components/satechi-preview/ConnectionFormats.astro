---
import BrochurePhoto from './BrochurePhoto.astro';
---
<div class="zi-connection-formats" aria-label="CBB60 connection formats">
  <BrochurePhoto name="cbb60-leads" zoom label="CBB60 wire-lead formats" sizes="(max-width: 700px) calc(100vw - 32px), (min-width: 1480px) 600px, 43vw">
    <h3>Wire leads</h3><p>Specify the lead length and connector.</p>
  </BrochurePhoto>
  <BrochurePhoto name="cbb60-terminals" zoom label="CBB60 blade-terminal formats" sizes="(max-width: 700px) calc(100vw - 32px), (min-width: 1480px) 600px, 43vw">
    <h3>Blade terminals</h3><p>Check blade spacing and connection clearance.</p>
  </BrochurePhoto>
</div>
