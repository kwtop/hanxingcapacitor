---
import BrochurePhoto from './BrochurePhoto.astro';
import FactoryMedia from './FactoryMedia.astro';
import InquiryCallout from '../InquiryCallout.astro';
import AboutVisitGallery from '../sunday/AboutVisitGallery.astro';
import AboutHeroVideo from '../sunday/AboutHeroVideo.astro';
import AboutChatContacts from '../sunday/AboutChatContacts.astro';
import { PUBLIC_BRAND_NAME, PUBLIC_HEADQUARTERS_ADDRESS, PUBLIC_FACTORY_ADDRESS, PUBLIC_COMPANY_RELATIONSHIP, PUBLIC_OFFICE_MOBILE, PUBLIC_OFFICE_PHONE, PUBLIC_COMPANY_NAME, PUBLIC_EMAIL } from '../../data/site';
---
<article class="procurement-page zi-about">
  <section class="zi-about-hero container">
    <div class="zi-about-intro">
      <p class="breadcrumbs"><a href="/">Home</a> / About</p>
      <h1>About HAN XING</h1>
      <p class="procurement-lead">{PUBLIC_COMPANY_RELATIONSHIP}</p>
      <nav class="procurement-actions" aria-label="Company information">
        <a class="button" href="/contact/?request=quote#inquiry-form">Request a capacitor quote</a>
      </nav>
    </div>
    <AboutHeroVideo />
  </section>

  <section class="zi-section zi-company-section" id="supplier-records">
    <div class="container zi-company-layout">
      <BrochurePhoto name="lobby" sizes="(max-width: 800px) calc(100vw - 32px), 44vw" />
      <div class="zi-company-copy">
        <h2>Company information</h2>
        <dl class="zi-company-records">
          <div><dt>Head company</dt><dd>{PUBLIC_COMPANY_NAME}</dd></div>
          <div><dt>Brand</dt><dd>{PUBLIC_BRAND_NAME} / Hanxing Capacitor</dd></div>
          <div><dt>Headquarters — Hangzhou</dt><dd>{PUBLIC_HEADQUARTERS_ADDRESS}</dd></div>
          <div><dt>Manufacturing facility — Hebei</dt><dd>{PUBLIC_FACTORY_ADDRESS}</dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a></dd></div>
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${PUBLIC_OFFICE_MOBILE.replace(/\s/g,'')}`}>{PUBLIC_OFFICE_MOBILE}</a> / <a href={`tel:${PUBLIC_OFFICE_PHONE.replace(/\s/g,'')}`}>{PUBLIC_OFFICE_PHONE}</a></dd>
          </div>
        </dl>
        <AboutChatContacts />
      </div>
    </div>
  </section>

  <section class="zi-section container zi-company-layout zi-company-products">
    <div class="zi-short-copy">
      <h2>Motor capacitor supply</h2>
      <p>We supply CBB60, CBB61 and CBB65 run capacitors and CD60 start capacitors for pumps, fans, refrigeration and other single-phase motor circuits.</p>
      <a class="card-link" href="/oem/">Explore custom labels and packaging</a>
    </div>
    <FactoryMedia name="batch" class="zi-company-batch" />
  </section>

  <section class="zi-section container zi-exhibition" aria-labelledby="zi-exhibition-title">
    <div class="zi-short-copy"><h2 id="zi-exhibition-title">Exhibitions</h2></div>
    <div class="zi-exhibition-pair">
      <BrochurePhoto name="exhibition-meeting" sizes="(max-width: 600px) min(320px, calc(100vw - 48px)), 320px" />
      <BrochurePhoto name="exhibition-products" sizes="(max-width: 600px) min(320px, calc(100vw - 48px)), 320px" />
    </div>
  </section>

  <AboutVisitGallery />
  <InquiryCallout>
    <nav aria-label="Product records">
      <a class="card-link" href="/factory/#model-records">Product document checklist</a>
      <a class="card-link" href="/products/">Compare capacitor series</a>
    </nav>
  </InquiryCallout>
</article>
