---
import { primaryNav, PUBLIC_BUSINESS_ADDRESS, PUBLIC_COMPANY_NAME, PUBLIC_EMAIL, PUBLIC_PHONE, WHATSAPP_URL } from '../data/site';
import '../styles/footer-navigation.css'; // Shared menu columns and contact icons.
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand"><a class="brand" href="/"><img class="selected-brand-mark" src="/favicon.svg" alt="" width="28" height="28" /><span class="brand-wordmark">HAN XING</span></a></div>
      <div class="footer-contact">
        <h4>Contact</h4>
        <div class="footer-contact-details">
          <a class="footer-contact-item footer-email" href={`mailto:${PUBLIC_EMAIL}`}><svg class="footer-contact-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg><span>{PUBLIC_EMAIL}</span></a>
          <a class="footer-contact-item" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${PUBLIC_PHONE}`}><svg class="footer-contact-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 11.8a8.6 8.6 0 0 1-12.8 7.5L3 20.6l1.3-4.7A8.6 8.6 0 1 1 20.6 11.8Z"/><path d="M8.1 7.5c-.5.6-.6 1.3-.3 2.1 1 2.7 3 4.7 5.7 5.7.8.3 1.5.2 2.1-.3l.9-1-2.3-1.2-.8.8c-1.6-.7-2.8-1.9-3.5-3.5l.8-.8-1.2-2.3Z"/></svg><span>{PUBLIC_PHONE}</span></a>
          <address class="footer-contact-item"><svg class="footer-contact-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><span>{PUBLIC_COMPANY_NAME}{PUBLIC_BUSINESS_ADDRESS !== PUBLIC_COMPANY_NAME && <><br />{PUBLIC_BUSINESS_ADDRESS}</>}</span></address>
        </div>
      </div>
      <nav class="footer-navigation" aria-label="Footer navigation">
        {primaryNav.filter(item => item.children.length > 0).map((item,index) => <div class="footer-nav-section">
          <div class="footer-nav-heading"><a class="footer-nav-primary" href={item.href}>{item.label}</a>{item.children.length > 0 && <button class="footer-nav-toggle" type="button" aria-label={`Expand ${item.label}`} aria-expanded="true" aria-controls={`footer-nav-${index}`} data-label={item.label}><span aria-hidden="true">−</span></button>}</div>
          {item.children.length > 0 && <div class="footer-nav-links" id={`footer-nav-${index}`}>{item.children.map(child => <a href={child.href}>{child.label}</a>)}</div>}
          {item.href === '/resources/' && <div class="footer-other-links">{primaryNav.filter(link => link.children.length === 0 && link.href !== '/').map(link => <a href={link.href}>{link.label}</a>)}</div>}
        </div>)}
      </nav>
    </div>
    <div class="footer-bottom"><p>© {new Date().getFullYear()} {PUBLIC_COMPANY_NAME}</p><a href="/terms/">Quotation &amp; order terms</a><a href="/privacy-policy/">Privacy notice</a></div>
  </div>
</footer>
<script>
  const footerToggles = document.querySelectorAll<HTMLButtonElement>('.footer-nav-toggle');
  const footerMobile = matchMedia('(max-width: 800px)');
  const setFooterExpanded = (toggle: HTMLButtonElement, expanded: boolean) => {
    const links = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    if (links) links.hidden = !expanded;
    toggle.setAttribute('aria-expanded', String(expanded));
    toggle.setAttribute('aria-label', `${expanded ? 'Collapse' : 'Expand'} ${toggle.dataset.label}`);
    const symbol = toggle.querySelector('span');
    if (symbol) symbol.textContent = expanded ? '−' : '+';
  };
  const syncFooter = () => footerToggles.forEach(toggle => {
    setFooterExpanded(toggle, !footerMobile.matches);
  });
  footerToggles.forEach(toggle => toggle.addEventListener('click', () => {
    setFooterExpanded(toggle, toggle.getAttribute('aria-expanded') !== 'true');
  }));
  footerMobile.addEventListener('change', syncFooter);
  syncFooter();
</script>

