---
import { primaryNav, PUBLIC_EMAIL, PUBLIC_PHONE, WHATSAPP_URL, PUBLIC_COMPANY_NAME, PUBLIC_BUSINESS_ADDRESS } from '../../data/site';
---
<footer class="su-footer"><div class="su-shell"><div class="su-footer-top"><div class="su-footer-brand"><a href="/" class="su-wordmark"><img src="/favicon.svg" alt="" width="30" height="30"/> HAN XING</a><p>Motor run & start capacitors</p><a href={`mailto:${PUBLIC_EMAIL}`}>{PUBLIC_EMAIL}</a><a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">WhatsApp {PUBLIC_PHONE}</a><address>{PUBLIC_COMPANY_NAME}<br/>{PUBLIC_BUSINESS_ADDRESS}</address></div><nav class="su-footer-nav" aria-label="Footer navigation">{primaryNav.filter(i=>i.children.length>0).map(item=><div><a class="su-footer-heading" href={item.href}>{item.label}</a>{item.children.map(child=><a href={child.href}>{child.label}</a>)}</div>)}<div><span class="su-footer-heading">Company</span><a href="/">Home</a><a href="/about/">About</a><a href="/contact/">Start an inquiry</a></div></nav></div><div class="su-footer-bottom"><p>© {new Date().getFullYear()} {PUBLIC_COMPANY_NAME}</p><nav aria-label="Legal"><a href="/terms/">Quotation & order terms</a><a href="/privacy-policy/">Privacy notice</a></nav></div></div></footer>
