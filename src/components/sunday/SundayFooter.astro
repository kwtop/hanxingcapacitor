---
import { primaryNav, PUBLIC_EMAIL, PUBLIC_PHONE, WHATSAPP_URL, PUBLIC_COMPANY_NAME, PUBLIC_HEADQUARTERS_ADDRESS, PUBLIC_FACTORY_ADDRESS } from '../../data/site';
import ContactIcon from '../ContactIcon.astro';
import LanguageSwitch from '../LanguageSwitch.astro';
import SocialLinks from '../SocialLinks.astro';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const overviewLabels: Record<string, string> = {
  '/products/': 'All products', '/applications/': 'All applications',
  '/oem-quality/': 'OEM & quality overview', '/resources/': 'All resources',
};
const groups = primaryNav.filter(item => item.children.length > 0);
---
<footer id="site-footer" class:list={['su-footer', 'su-footer--refined', { 'su-footer--compact': compact }]}>
  <div class="su-shell">
    {compact ? <div class="su-footer-compact-content">
      <div><a href="/" class="su-wordmark"><img src="/favicon.svg" alt="" width="30" height="30" /> HAN XING</a><SocialLinks location="footer" /></div>
      <address>{PUBLIC_COMPANY_NAME}<br /><strong>Headquarters — Hangzhou</strong><br />{PUBLIC_HEADQUARTERS_ADDRESS}<br /><strong>Manufacturing facility — Hebei</strong><br />{PUBLIC_FACTORY_ADDRESS}</address>
      <nav class="su-footer-short-nav" aria-label="Footer navigation">{primaryNav.filter(item => item.href !== '/').map(item => <a href={item.href}>{item.label}</a>)}</nav>
    </div> : <>
      <div class="su-footer-masthead">
        <div class="su-footer-brand">
          <a href="/" class="su-wordmark"><img src="/favicon.svg" alt="" width="30" height="30" /> HAN XING</a>
          <p class="su-footer-company">HAN XING is the capacitor brand of {PUBLIC_COMPANY_NAME}</p>
        </div>
        <div class="su-footer-actions">
          <div class="su-footer-contact-links" role="group" aria-label="Contact">
            <a class="su-footer-contact" href={`mailto:${PUBLIC_EMAIL}`}><ContactIcon name="email" size={18} /><span>{PUBLIC_EMAIL}</span></a>
            <a class="su-footer-contact" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${PUBLIC_PHONE}`}><ContactIcon name="whatsapp" size={20} /><span>{PUBLIC_PHONE}</span></a>
          </div>
          <a class="su-footer-quote" href="/contact/"><span>Start an inquiry</span><span aria-hidden="true">→</span></a>
        </div>
      </div>
      <nav class="su-footer-nav" aria-label="Footer navigation">
        {groups.map(group => <details class="su-footer-group" data-footer-group open>
          <summary><span>{group.label}</span><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 6 4 4 4-4" /></svg></summary>
          <h2 class="su-footer-heading">{group.label}</h2>
          <div class="su-footer-group-links">
            {group.children.map(child => <a href={child.href}>{child.label}</a>)}
            <a class="su-footer-overview" href={group.href}>{overviewLabels[group.href]}<span aria-hidden="true">→</span></a>
          </div>
        </details>)}
      </nav>
      <div class="su-footer-locations">
        <address class="su-footer-address">
          <ContactIcon name="location" size={18} />
          <div><strong>Headquarters — Hangzhou</strong><span>{PUBLIC_HEADQUARTERS_ADDRESS}</span></div>
        </address>
        <address class="su-footer-address">
          <ContactIcon name="location" size={18} />
          <div><strong>Manufacturing facility — Hebei</strong><span>{PUBLIC_FACTORY_ADDRESS}</span></div>
        </address>
        <SocialLinks location="footer" />
      </div>
    </>}
    <div class="su-footer-bottom">
      <p>© {new Date().getFullYear()} {PUBLIC_COMPANY_NAME}</p>
      <div class="su-footer-utilities">
        {!compact && <a class="su-footer-about" href="/about/">About US</a>}
        <LanguageSwitch />
        <nav class="su-footer-legal" aria-label="Legal"><a href="/terms/">Quotation & order terms</a><a href="/privacy-policy/">Privacy notice</a></nav>
      </div>
    </div>
  </div>
</footer>

<script>
  for (const footer of document.querySelectorAll<HTMLElement>('.su-footer--refined')) {
    const groups = footer.querySelectorAll<HTMLDetailsElement>('[data-footer-group]');
    const narrow = matchMedia('(max-width: 799px)');
    const sync = () => groups.forEach(group => { group.open = !narrow.matches; });
    sync();
    narrow.addEventListener('change', sync);
  }
</script>

<style is:inline>
  .su-footer.su-footer--refined {
    --footer-text: #f4f7f9;
    --footer-muted: #c1cbd4;
    --footer-line: #43515d;
    --footer-location: #24323e;
    padding: 40px 0 18px;
    background: #18222c;
    color: var(--footer-text);
    scroll-margin-top: 96px;
  }
  .su-footer-masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 3vw, 42px);
    padding-bottom: 22px;
    border-bottom: 1px solid var(--footer-line);
  }
  .su-footer--refined .su-footer-brand .su-wordmark { width: fit-content; font-size: 27px; }
  .su-footer--refined .su-footer-brand .su-footer-company {
    max-width: 46ch;
    margin: 9px 0 0;
    color: var(--footer-muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .su-footer-actions { display: flex; align-items: center; gap: 22px; min-width: 0; }
  .su-footer-contact-links { display: flex; align-items: center; gap: 16px; min-width: 0; }
  .su-footer--refined .su-footer-contact {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    color: var(--footer-text);
    font-size: 14px;
    line-height: 1.45;
    text-decoration: none;
  }
  .su-footer-contact span { min-width: 0; overflow-wrap: anywhere; }
  .su-footer-contact .contact-icon--email { color: var(--footer-muted); }
  .su-footer--refined .su-footer-quote {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 10px 17px;
    border-radius: 100px;
    background: var(--su-accent, #c55000);
    color: #fff;
    font-size: 14px;
    font-weight: 650;
    line-height: 1.4;
    text-decoration: none;
  }
  .su-footer--refined .su-footer-quote:hover { background: var(--su-accent-hover, #a63d00); color: #fff; }
  .su-footer--refined .su-footer-nav {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 24px clamp(20px, 3vw, 42px);
    margin: 0;
    padding-block: 22px 24px;
  }
  .su-footer-group { min-width: 0; }
  .su-footer--refined .su-footer-group .su-footer-heading {
    margin: 0;
    color: var(--footer-text);
    font-size: 15px;
    line-height: 1.5;
    font-weight: 650;
    letter-spacing: normal;
  }
  .su-footer-group summary {
    display: none;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    padding: 0;
    color: var(--footer-text);
    font-size: 15px;
    line-height: 1.4;
    font-weight: 650;
    list-style: none;
    cursor: pointer;
  }
  .su-footer-group summary::-webkit-details-marker { display: none; }
  .su-footer-group summary svg { flex-shrink: 0; color: var(--footer-muted); transition: transform .16s ease; }
  .su-footer-group[open] summary svg { transform: rotate(180deg); }
  .su-footer-group-links { display: flex; flex-direction: column; align-items: flex-start; padding-top: 8px; }
  .su-footer--refined .su-footer-group-links a {
    max-width: 100%;
    padding: 4px 0;
    color: var(--footer-muted);
    font-size: 14px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .su-footer--refined .su-footer-group-links .su-footer-overview { margin-top: 3px; color: var(--footer-text); font-size: 13px; }
  .su-footer-overview span { margin-inline-start: 6px; }
  .su-footer-locations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) auto;
    align-items: center;
    gap: 12px clamp(16px, 3vw, 42px);
    padding: 16px 20px;
    border-radius: 10px;
    background: var(--footer-location);
  }
  .su-footer--refined address.su-footer-address {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0;
    color: var(--footer-muted);
    font: 400 13px/1.6 var(--su-font);
  }
  .su-footer--refined .su-footer-address > svg { margin-top: 1px; color: var(--footer-muted); }
  .su-footer-address strong { display: block; margin-bottom: 4px; color: var(--footer-text); font-weight: 650; }
  .su-footer-address span { display: block; max-width: 62ch; }
  .su-footer--refined .su-footer-locations .social-links { gap: 8px; margin: 0; color: var(--footer-text); }
  .su-footer--refined .su-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 10px;
    padding-top: 0;
    border: 0;
    color: var(--footer-muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .su-footer-bottom p { margin: 0; }
  .su-footer-utilities { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 18px; }
  .su-footer--refined .su-footer-utilities nav { margin: 0; }
  .su-footer--refined .su-footer-utilities .hx-language { gap: 2px; }
  .su-footer--refined .su-footer-utilities .su-footer-legal { align-items: center; flex-wrap: wrap; gap: 4px 16px; }
  .su-footer-bottom a { color: inherit; text-decoration: none; }
  .su-footer-group summary:focus-visible, .su-footer--refined a:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .su-footer--refined :is(.su-footer-group-links a, .su-footer-contact, .su-footer-about, .su-footer-legal a):hover {
    color: var(--footer-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .su-footer--refined.su-footer--compact { padding-top: 40px; }
  .su-footer-compact-content { display: grid; grid-template-columns: .75fr 1fr 1fr; align-items: start; gap: 40px; }
  .su-footer-compact-content address { margin: 0; max-width: 420px; color: var(--footer-muted); font: 400 12px/1.8 var(--su-font); }
  .su-footer-short-nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12px 22px; }
  .su-footer-short-nav a { color: #d7d7db; font-size: 12px; line-height: 1.6; padding-block: 3px; }
  @media (max-width: 1099px) {
    .su-footer-contact-links { flex-direction: column; align-items: flex-start; gap: 0; }
  }
  @media (max-width: 999px) {
    .su-footer-compact-content { grid-template-columns: 1fr 1fr; gap: 24px 32px; }
    .su-footer-short-nav { grid-column: 1/-1; justify-content: flex-start; }
  }
  @media (max-width: 799px) {
    .su-footer--refined .su-footer-nav { grid-template-columns: 1fr; gap: 0; padding-block: 0 18px; }
    .su-footer-group { border-bottom: 1px solid var(--footer-line); }
    .su-footer--refined .su-footer-group .su-footer-heading { display: none; }
    .su-footer-group summary { display: flex; justify-content: space-between; min-height: 48px; padding-block: 8px; font-size: 14px; }
    .su-footer-group-links { padding: 0 0 10px; }
    .su-footer--refined .su-footer-group-links a { min-height: 44px; padding: 11px 0; }
  }
  @media (max-width: 699px) {
    .su-footer.su-footer--refined { padding: 30px 0 20px; }
    .su-footer-masthead { grid-template-columns: minmax(0, 1fr); justify-items: start; gap: 12px; padding-bottom: 18px; }
    .su-footer-actions { flex-wrap: wrap; gap: 8px 18px; }
    .su-footer--refined .su-footer-brand .su-wordmark { font-size: 25px; }
    .su-footer--refined .su-footer-contact { min-height: 44px; }
    .su-footer-locations { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0 16px; }
    .su-footer--refined .su-footer-locations .su-footer-address { padding-block: 13px; }
    .su-footer-locations .su-footer-address + .su-footer-address { border-top: 1px solid var(--footer-line); }
    .su-footer--refined .su-footer-locations .social-links { padding-block: 10px; border-top: 1px solid var(--footer-line); }
    .su-footer--refined .su-footer-bottom { align-items: flex-start; flex-direction: column; margin-top: 12px; }
    .su-footer--refined .su-footer-bottom p { order: 1; }
    .su-footer-utilities { width: 100%; }
    .su-footer--refined .su-footer-utilities .hx-language { margin-inline-start: auto; }
    .su-footer--refined .su-footer-legal { flex-basis: 100%; padding-block: 6px; }
    .su-footer-compact-content { grid-template-columns: 1fr; gap: 20px; }
    .su-footer-compact-content address { max-width: 310px; }
    .su-footer-short-nav { gap: 10px 20px; }
    .su-footer-short-nav a { padding-block: 7px; }
  }
  @media (prefers-reduced-motion: reduce) { .su-footer-group summary svg { transition: none; } }
</style>
