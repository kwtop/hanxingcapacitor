---
import { oemNavigation } from '../../data/oemNavigation';
const items = [{ label: 'Overview', href: '/oem-quality/' }, ...oemNavigation];
const path = Astro.url.pathname;
const current = items.find(item => item.href === path);
---
<div class="oe-section-nav">
  <nav class="oe-section-nav-desktop" aria-label="OEM and quality pages">
    {items.map(item => <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <details class="oe-section-nav-mobile">
    <summary><span>Explore OEM &amp; quality</span><strong>{current?.label ?? 'Overview'}</strong><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" /></svg></summary>
    <nav aria-label="OEM and quality pages">
      {items.map(item => <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </details>
</div>
<style>
  .oe-section-nav{margin-bottom:40px;border-block:1px solid #dde2e6}
  .oe-section-nav-desktop{display:flex;align-items:stretch;gap:32px}
  .oe-section-nav a{display:flex;align-items:center;min-height:58px;padding:14px 0;color:#5d666d;text-decoration:none;font:500 14px/1.5 var(--su-font);border-bottom:2px solid transparent;margin-bottom:-1px}
  .oe-section-nav a:hover{color:var(--su-accent)}
  .oe-section-nav a[aria-current="page"]{color:var(--su-accent);border-color:currentColor}
  .oe-section-nav :is(a,summary):focus-visible{outline:2px solid var(--su-accent);outline-offset:4px}
  .oe-section-nav-mobile{display:none}
  @media(max-width:1100px){.oe-section-nav-desktop{gap:24px}.oe-section-nav a{font-size:13px}}
  @media(max-width:800px){
    .oe-section-nav{margin-bottom:32px}
    .oe-section-nav-desktop{display:none}
    .oe-section-nav-mobile{display:block}
    summary{display:grid;grid-template-columns:minmax(0,1fr) 16px;gap:3px 16px;align-items:center;padding:14px 0;cursor:pointer;list-style:none}
    summary::-webkit-details-marker{display:none}
    summary>span{font:400 12px/1.5 var(--su-font);color:#6a7278}
    summary>strong{grid-column:1;font:600 15px/1.5 var(--su-font);color:var(--su-ink)}
    summary>svg{grid-column:2;grid-row:1/3;transition:transform .15s}
    details[open] summary>svg{transform:rotate(180deg)}
    details nav{display:grid;border-top:1px solid #e4e8eb;padding:8px 0 12px}
    .oe-section-nav details a{min-height:44px;padding:10px 12px;margin:0;border:0;font-size:14px;border-radius:6px}
    .oe-section-nav details a[aria-current="page"]{background:#f3f5f6}
  }
  @media(prefers-reduced-motion:reduce){summary>svg{transition:none}}
</style>
