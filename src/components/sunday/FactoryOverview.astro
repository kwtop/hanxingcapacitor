---
import Action from './Action.astro';
import { manufacturingStatic } from '../../data/manufacturingStatic';
import { sourcePhotography } from '../../data/sourcePhotography';
import factoryExterior from '../../data/factoryExterior.generated.json';
import { PUBLIC_COMPANY_RELATIONSHIP } from '../../data/site';

const workshopOriginal = sourcePhotography['05-line-wide'];
const workshopRetouch = '/images/workshop-retouch-20261104/workshop';
---
<section class="su-factory-overview" id="workshop-moments" aria-labelledby="production-title">
  <div class="su-shell">
    <header class="su-factory-heading">
      <h2 id="production-title">Manufacturing &amp; quality</h2>
      <Action href="/factory/" quiet>Explore manufacturing</Action>
    </header>
    <p class="su-factory-context">{PUBLIC_COMPANY_RELATIONSHIP}</p>
    <div class="su-factory-media">
      <figure class="su-factory-main" data-photo-kind={factoryExterior.kind} data-source-id={factoryExterior.sourceId} data-original-src={factoryExterior.originalSrc}>
        <a class="su-factory-image" href="/about/" aria-label="About the Hanxing factory">
          <img src={factoryExterior.src} srcset={factoryExterior.srcset} sizes="(max-width: 760px) calc(100vw - 48px), (min-width: 1420px) 782px, 56vw" width={factoryExterior.width} height={factoryExterior.height} alt={factoryExterior.alt} loading="lazy" decoding="async" />
        </a>
        <figcaption><h3>Hanxing factory</h3></figcaption>
      </figure>
      <div class="su-factory-support">
        <figure>
          <a class="su-factory-image" href="/factory/#electrical-testing"><img src={manufacturingStatic.testing.src} srcset={manufacturingStatic.testing.srcset} sizes="(max-width: 520px) calc(100vw - 48px), (max-width: 760px) calc((100vw - 72px) / 2), (min-width: 1420px) 562px, calc((100vw - 72px) * .41667)" width={manufacturingStatic.testing.width} height={manufacturingStatic.testing.height} alt={manufacturingStatic.testing.alt} loading="lazy" decoding="async" /></a>
          <figcaption><h3>Electrical testing</h3></figcaption>
        </figure>
        <figure data-photo-kind="ai-refined-illustration" data-original-src={workshopOriginal.original}>
          <a class="su-factory-image" href="/factory/process-gallery/">
            <img
              src={`${workshopRetouch}-1280.webp`}
              srcset={`${workshopRetouch}-480.webp 480w, ${workshopRetouch}-800.webp 800w, ${workshopRetouch}-1280.webp 1280w`}
              sizes="(max-width: 520px) calc(100vw - 48px), (max-width: 760px) calc((100vw - 72px) / 2), (min-width: 1420px) 562px, calc((100vw - 72px) * .41667)"
              width="1280"
              height="720"
              alt="Operator at a capacitor assembly machine beside trays of metal cans."
              loading="lazy"
              decoding="async"
            />
          </a>
          <figcaption><h3>Production workshop</h3></figcaption>
        </figure>
      </div>
    </div>

  </div>
</section>

<style>
  .su-factory-overview { margin-top: 96px; padding: 72px 0; background: #f4f6f7; scroll-margin-top: 100px; }
  .su-factory-heading { display: flex; justify-content: space-between; gap: 24px 48px; align-items: center; margin-bottom: 44px; }
  .su-factory-heading h2 { margin: 0; font: 750 clamp(36px, 3.6vw, 52px)/1.08 var(--su-heading); letter-spacing: -.04em; }
  .su-factory-heading :global(.su-action) { flex-shrink: 0; min-height: 44px; color: var(--su-accent, #a63d00); font-size: 16px; }
  .su-factory-context { max-width: 84ch; color: #57616b; line-height: 1.7; margin: -16px 0 32px; }
  .su-factory-heading :global(.su-action:is(:hover,:focus-visible,:visited)) { color: #8f3400; }
  .su-factory-media { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 32px; align-items: stretch; }
  .su-factory-main { display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 18px; min-width: 0; margin: 0; }
  .su-factory-image { position: relative; display: block; min-width: 0; overflow: hidden; border-radius: var(--su-photo-radius); background: #dce1e5; }
  .su-factory-image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .su-factory-main .su-factory-image { min-height: 360px; }
  .su-factory-main img { position: absolute; inset: 0; object-position: 50% 50%; }
  .su-factory-support { display: grid; gap: 32px; min-width: 0; }
  .su-factory-support figure { display: grid; gap: 16px; min-width: 0; margin: 0; }
  .su-factory-support .su-factory-image { aspect-ratio: 1.82; }
  .su-factory-support figure:first-child img { object-position: 50% 85%; }
  .su-factory-support figure:last-child .su-factory-image { aspect-ratio: 2.12; }
  .su-factory-support figure:last-child img { object-position: 50% 50%; }
  .su-factory-image:focus-visible { outline: 3px solid var(--su-accent); outline-offset: 4px; }
  figcaption h3 { margin: 0; font: 650 20px/1.3 var(--su-heading); letter-spacing: -.035em; color: var(--su-ink); }
  @media (max-width: 1079px) {
    .su-factory-heading :global(.su-action) { font-size: 15px; }
    figcaption h3 { font-size: 18px; }
  }
  @media (max-width: 760px) {
    .su-factory-overview { margin-top: 64px; padding: 48px 0; }
    .su-factory-heading { flex-direction: column; align-items: flex-start; gap: 16px; margin-bottom: 28px; }
    .su-factory-heading h2 { font-size: 34px; }
    .su-factory-context { max-width: 84ch; color: #57616b; line-height: 1.7; margin: -16px 0 32px; }
  .su-factory-heading :global(.su-action:is(:hover,:focus-visible,:visited)) { color: #8f3400; }
  .su-factory-media { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .su-factory-main .su-factory-image { min-height: 0; aspect-ratio: 1.5; }
    .su-factory-main img { object-position: 50% 50%; }
    .su-factory-support { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    .su-factory-support .su-factory-image, .su-factory-support figure:last-child .su-factory-image { aspect-ratio: 1.5; }
  }
  @media (max-width: 520px) {
    .su-factory-heading h2 { font-size: 30px; }
    .su-factory-support { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .su-factory-main .su-factory-image { aspect-ratio: 1.33; }
    .su-factory-support .su-factory-image, .su-factory-support figure:last-child .su-factory-image { aspect-ratio: 1.6; }
  }
</style>
