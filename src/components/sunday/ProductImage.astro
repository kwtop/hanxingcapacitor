---
import { polishedEditorial } from '../../data/imagePolish';
interface Props { name: string; alt: string; eager?: boolean; sizes?: string; }
const { name, alt, eager = false, sizes = '(max-width: 767px) 100vw, 60vw' } = Astro.props;
const square = name === 'family' || name === 'terminals';
const refined = name === 'connections' ? polishedEditorial.connections : name === 'terminals' ? polishedEditorial.terminals : name === 'packaging' ? polishedEditorial.packing : name === 'family' ? polishedEditorial.catalog : undefined;
---
<img src={refined?.src ?? `/images/sunday-home/${name}-800.webp`} srcset={refined?.srcset ?? [480,800,1280].map(w=>`/images/sunday-home/${name}-${w}.webp ${square && w === 1280 ? 1254 : w}w`).join(', ')} sizes={sizes} width={refined?.width ?? (square ? 1254 : 1536)} height={refined?.height ?? (square ? 1254 : 1024)} alt={refined?.alt ?? alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
