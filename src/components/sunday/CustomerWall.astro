---
import { customerVisits } from '../../data/customerVisits';
---
<section class="su-shell su-customer-wall" id="customer-visits" aria-labelledby="customer-visits-title">
  <header class="su-customer-heading"><h2 id="customer-visits-title">Customer visits &amp; exhibitions</h2></header>
  <div class="su-customer-grid">
    {customerVisits.map((photo, index) => <figure class:list={['su-customer-photo', { 'su-customer-photo--main': index === 0 }]}>
      <a href={photo.fullSrc} target="_blank" rel="noopener" aria-label={`Open full photograph: ${photo.caption}`}><img src={photo.src} srcset={photo.srcset} sizes={index === 0 ? '(max-width: 800px) calc(100vw - 48px), 48vw' : '(max-width: 800px) calc((100vw - 64px) / 2), 24vw'} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" style={`object-position:${photo.focus}`} /></a>
    </figure>)}
  </div>
</section>

<style>
  .su-customer-wall { padding-top: 8px; padding-bottom: 96px; scroll-margin-top: 100px; }
  .su-customer-heading { margin-bottom: 36px; }
  .su-customer-heading h2 { margin: 0; font: 750 44px/1.12 var(--su-heading); letter-spacing: -.04em; }
  .su-customer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: repeat(2, 220px); gap: 32px 24px; }
  .su-customer-photo { min-width: 0; min-height: 0; margin: 0; }
  .su-customer-photo--main { grid-row: span 2; }
  .su-customer-photo a { display: block; overflow: hidden; border-radius: var(--su-photo-radius); height: 220px; background: #e6e9ec; }
  .su-customer-photo--main a { height: 100%; min-height: 450px; }
  .su-customer-photo img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .25s ease; }
  .su-customer-photo a:hover img { transform: scale(1.02); }
  @media (max-width: 1079px) {
    .su-customer-heading h2 { font-size: 36px; }
    .su-customer-grid { grid-template-rows: repeat(2, 180px); gap: 22px 16px; }
    .su-customer-photo a { height: 180px; }
    .su-customer-photo--main a { height: 100%; min-height: 360px; }
  }
  @media (max-width: 800px) {
    .su-customer-wall { padding-bottom: 64px; }
    .su-customer-heading { margin-bottom: 28px; }
    .su-customer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; }
    .su-customer-photo--main { grid-row: auto; grid-column: span 2; }
    .su-customer-photo a { height: auto; aspect-ratio: 4/3; }
    .su-customer-photo--main a { height: auto; min-height: 0; aspect-ratio: 4/3; }
  }
  @media (max-width: 599px) {
    .su-customer-heading h2 { font-size: 30px; }
    .su-customer-grid { gap: 28px 16px; }
    .su-customer-photo a { aspect-ratio: 1; border-radius: 14px; }
    .su-customer-photo--main a { aspect-ratio: 4/3; }
  }
  @media (prefers-reduced-motion: reduce) { .su-customer-photo img { transition: none; } }
</style>
