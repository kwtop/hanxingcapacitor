---
import ContactIcon from '../ContactIcon.astro';
import SocialLinks from '../SocialLinks.astro';
import { companyProfile } from '../../data/company';

const { wechat, whatsappBusiness } = companyProfile.contact;
const position = Astro.url.pathname.includes('/contact') ? 'contact' : 'about';
const channels = [
  { id: 'wechat', label: 'WeChat', qr: wechat.qr, size: wechat.qrSize, hint: 'Scan in WeChat or use a screenshot from your album.' },
  { id: 'whatsapp', label: 'WhatsApp', qr: whatsappBusiness.qr, size: whatsappBusiness.qrSize, hint: 'Scan with your phone to open the chat.' },
] as const;
---
<div class="about-chat-channels">
  <div class="about-chat-tile">
    <a class="about-chat-link" href={wechat.qr} data-about-qr data-analytics-event="wechat_click" data-analytics-position={`${position}_wechat_qr`} aria-haspopup="dialog" aria-controls="about-wechat-qr" aria-label="Show WeChat QR code">
      <ContactIcon name="wechat" size={26} />
      <span class="about-chat-text"><strong>WeChat</strong><span>Scan QR code</span></span>
      <span class="about-chat-qr-mark"><ContactIcon name="qr" size={18} /></span>
    </a>
  </div>
  <div class="about-chat-tile">
    <a class="about-chat-link" href={whatsappBusiness.url} data-analytics-position={`${position}_whatsapp_chat`} target="_blank" rel="noopener noreferrer">
      <ContactIcon name="whatsapp" size={26} />
      <span class="about-chat-text"><strong>WhatsApp</strong><span>Open chat</span></span>
    </a>
    <a class="about-chat-qr-link" href={whatsappBusiness.qr} data-about-qr data-analytics-event="whatsapp_click" data-analytics-position={`${position}_whatsapp_qr`} aria-haspopup="dialog" aria-controls="about-whatsapp-qr" aria-label="Show WhatsApp QR code">
      <ContactIcon name="qr" size={18} />
    </a>
  </div>
</div>

<SocialLinks location={position} />

{channels.map(channel => (
  <dialog class="about-chat-dialog" id={`about-${channel.id}-qr`} aria-labelledby={`about-${channel.id}-title`} aria-describedby={`about-${channel.id}-hint`}>
    <div class="about-chat-dialog-header">
      <h3 id={`about-${channel.id}-title`}><ContactIcon name={channel.id} size={24} />{channel.label}</h3>
      <form method="dialog">
        <button class="about-chat-close" type="submit" aria-label="Close QR code" autofocus>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </form>
    </div>
    <img class="about-chat-code" src={channel.qr} alt={`${channel.label} contact QR code`} width={channel.size} height={channel.size} loading="lazy" decoding="async" />
    {channel.id === 'wechat' && <div class="about-chat-account">{wechat.name}</div>}
    <div class="about-chat-hint" id={`about-${channel.id}-hint`}>{channel.hint}</div>
    {channel.id === 'whatsapp' && <a class="about-chat-direct" href={whatsappBusiness.url} data-analytics-position={`${position}_whatsapp_qr_chat`} target="_blank" rel="noopener noreferrer">Open chat</a>}
  </dialog>
))}

<script>
  for (const trigger of document.querySelectorAll<HTMLAnchorElement>('[data-about-qr]')) {
    const dialog = document.getElementById(trigger.getAttribute('aria-controls') ?? '');
    if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== 'function') continue;
    trigger.addEventListener('click', event => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      dialog.showModal();
    });
  }
</script>

<style>
  .about-chat-channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 12px;
    margin-top: 18px;
  }
  .about-chat-tile {
    --contact-icon-cutout: #26313c;
    display: flex;
    min-width: 0;
    overflow: hidden;
    color: #fff;
    background: #26313c;
    border: 1px solid #ffffff29;
    border-radius: 10px;
  }
  .about-chat-link, .about-chat-qr-link {
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .about-chat-link { flex: 1; min-width: 0; gap: 12px; padding: 11px 14px; }
  .about-chat-text { display: grid; gap: 2px; }
  .about-chat-text strong { font-size: 15px; font-weight: 650; }
  .about-chat-text span { color: #c2cdd7; font-size: 13px; }
  .about-chat-qr-mark { margin-inline-start: auto; color: #c2cdd7; }
  .about-chat-qr-link { justify-content: center; flex: 0 0 48px; border-inline-start: 1px solid #ffffff29; }
  .about-chat-link:hover, .about-chat-qr-link:hover { background: #34414f; }
  .about-chat-link:focus-visible, .about-chat-qr-link:focus-visible { outline: 2px solid white; outline-offset: -4px; }

  .about-chat-dialog {
    box-sizing: border-box;
    width: min(352px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 18px 20px 22px;
    border: 0;
    border-radius: 16px;
    overflow: auto;
    color: #19232d;
    background: white;
    text-align: center;
  }
  .about-chat-dialog::backdrop { background: rgb(12 19 28 / 70%); }
  .about-chat-dialog-header, .about-chat-dialog-header h3 { display: flex; align-items: center; }
  .about-chat-dialog-header { justify-content: space-between; gap: 8px; }
  .about-chat-dialog-header h3 { gap: 8px; margin: 0; font-size: 20px; }
  .about-chat-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: inherit;
    background: #f0f2f4;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
  }
  .about-chat-close:hover { background: #e6eaee; }
  .about-chat-code { display: block; width: min(100%, 250px); height: auto; margin: 8px auto 0; }
  .about-chat-account { margin-bottom: 4px; font-weight: 650; }
  .about-chat-hint { color: #4a5662; font-size: 14px; line-height: 1.5; }
  .about-chat-direct {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 16px;
    padding: 0 16px;
    border-radius: 8px;
    color: white;
    background: #19232d;
    text-decoration: none;
  }
  .about-chat-direct:hover { background: #34414f; }
  .about-chat-close:focus-visible, .about-chat-direct:focus-visible { outline: 2px solid #19232d; outline-offset: 2px; }
</style>
