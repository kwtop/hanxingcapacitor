---
import SeriesInquiry from './SeriesInquiry.astro';
import { sourceBanners } from '../../data/sourcePhotography';
import '../../styles/home-industrial-banner.css';
const desktop = sourceBanners['banner-desktop'];
const tablet = sourceBanners['banner-tablet'];
const mobile = sourceBanners['banner-mobile'];
---
<section class="su-home-banner" aria-labelledby="home-title">
  <picture class="su-home-banner-photo">
    <!-- The mobile crop keeps the right edge and matches the 120vw image height in CSS. -->
    <source media="(max-width: 599px)" srcset={mobile.srcset} sizes="111.2vw" width={mobile.width} height={mobile.height} />
    <source media="(max-width: 1023px)" srcset={tablet.srcset} sizes="max(100vw, 750px, 75svh)" width={tablet.width} height={tablet.height} />
    <img src={desktop.src} srcset={desktop.srcset} sizes="max(100vw, 1138px, min(177.7svh, 111.1vw))" width={desktop.width} height={desktop.height} loading="eager" fetchpriority="high" decoding="async" alt={desktop.alt} />
  </picture>
  <div class="su-shell su-home-banner-inner">
    <div class="su-home-banner-copy">
      <h1 id="home-title">Motor capacitor <br /><span>manufacturer</span></h1>
      <p>CBB60, CBB61 and CBB65 run capacitors.<br class="su-banner-desktop-break" /> CD60 for starting duty.</p>
      <SeriesInquiry id="hero-inquiry" showLabel={false} />
    </div>
  </div>
</section>
