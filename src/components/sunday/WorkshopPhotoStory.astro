---
import type { WorkshopPhoto } from '../../data/workshopPhotos';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro: string;
  photos: readonly WorkshopPhoto[];
  compact?: boolean;
  imageBase?: string;
  moreHref?: string;
  moreLabel?: string;
}
const { id, eyebrow, title, intro, photos, compact = false, imageBase = '/images/workshop-stories-20261026/', moreHref, moreLabel = 'View the full process gallery' } = Astro.props;
---
<section id={id} class:list={['su-photo-story', {
  'su-photo-story--compact': compact,
  'su-photo-story--triptych': !compact && photos.length === 3,
  'su-photo-story--six': !compact && photos.length === 6,
  'su-photo-story--seven': !compact && photos.length === 7,
  'su-photo-story--five-portrait': !compact && photos.length === 5 && photos[0]?.frame === 'portrait',
}]} aria-labelledby={`${id}-title`}>
  <div class="su-photo-story-inner">
    <header class="su-photo-story-head">
      <div><p class="su-photo-story-eyebrow">{eyebrow}</p><h2 id={`${id}-title`}>{title}</h2>{moreHref && <a class="su-photo-story-more" href={moreHref}>{moreLabel} <span aria-hidden="true">↗</span></a>}</div>
      <p>{intro}</p>
    </header>
    <div class="su-photo-story-grid">
      {photos.map((item, index) => <figure class="su-photo-story-item" data-frame={item.frame ?? 'landscape'}>
        <a class="su-photo-story-image" href={item.src ?? `${imageBase}${item.slug}.webp`} target="_blank" rel="noopener" aria-label={`Open full image: ${item.caption}`}><img src={item.src ?? `${imageBase}${item.slug}.webp`} alt={item.alt} loading="lazy" decoding="async" style={item.focus ? `object-position:${item.focus}` : undefined} /></a>
        <figcaption><span class="su-photo-story-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{item.caption}{item.illustrative && <small>Illustrative visual based on supplied footage</small>}</span></figcaption>
      </figure>)}
    </div>
  </div>
</section>

<style>
  .su-photo-story { padding: 88px 24px; background: #f4f6f7; color: #14202a; }
  .su-photo-story-inner { width: 100%; max-width: 1372px; margin: 0 auto; }
  .su-photo-story-head { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(250px, .6fr); gap: 32px; align-items: end; margin-bottom: 38px; }
  .su-photo-story-eyebrow { color: #b84b08; text-transform: uppercase; letter-spacing: .13em; font-size: 12px; font-weight: 700; margin: 0 0 15px !important; }
  .su-photo-story-head h2 { font: 700 clamp(31px, 4vw, 48px)/1.08 'Sunday Jakarta', sans-serif !important; letter-spacing: -.045em !important; margin: 0 !important; max-width: 760px; }
  .su-photo-story-more { display: inline-flex; gap: 7px; align-items: center; margin-top: 16px; color: #a64106; font: 650 14px/1.35 'Sunday Geist', sans-serif; text-underline-offset: 5px; }
  .su-photo-story-head > p { max-width: 410px; color: #52606b; font: 400 16px/1.6 'Sunday Geist', sans-serif; margin: 0 0 3px !important; }
  .su-photo-story-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 28px 20px; }
  .su-photo-story-item { grid-column: span 4; min-width: 0; margin: 0 !important; }
  .su-photo-story-item:first-child:not([data-frame='portrait']) { grid-column: span 8; }
  .su-photo-story-image { display: block; width: 100%; height: 0; padding-bottom: 73%; position: relative; overflow: hidden; border-radius: 16px; background: #dfe5e9; }
  .su-photo-story-item:first-child:not([data-frame='portrait']) .su-photo-story-image { padding-bottom: 35.5%; }
  .su-photo-story-item[data-frame='portrait'] .su-photo-story-image { padding-bottom: 122%; }
  :global(.su-photo-story--triptych) .su-photo-story-item:first-child:not([data-frame='portrait']) { grid-column: span 6; }
  :global(.su-photo-story--triptych) .su-photo-story-item:not(:first-child) { grid-column: span 3; }
  :global(.su-photo-story--triptych) .su-photo-story-item:first-child:not([data-frame='portrait']) .su-photo-story-image { padding-bottom: 64%; }
  :global(.su-photo-story--seven) .su-photo-story-item:nth-last-child(2) { grid-column: span 6; }
  :global(.su-photo-story--six) .su-photo-story-item:last-child { grid-column: 5 / span 4; }
  :global(.su-photo-story--five-portrait) .su-photo-story-item:nth-last-child(2) { grid-column: 3 / span 4; }
  :global(.su-photo-story--five-portrait) .su-photo-story-item:last-child { grid-column: 7 / span 4; }
  .su-photo-story-image img { position: absolute; inset: 0; width: 100%; height: 100% !important; object-fit: cover; display: block; transition: transform .5s ease; }
  .su-photo-story-item:hover img { transform: scale(1.025); }
  .su-photo-story-image:focus-visible { outline: 3px solid #b84b08; outline-offset: 4px; }
  .su-photo-story-item figcaption { display: flex; gap: 12px; padding: 12px 2px 0; font: 500 14px/1.45 'Sunday Geist', sans-serif; color: #1c2934; }
  .su-photo-story-number { flex: 0 0 auto; color: #b84b08; font-size: 11px; letter-spacing: .08em; line-height: 1.85; }
  .su-photo-story-item small { display: block; margin-top: 4px; color: #65717a; font-size: 11px; font-weight: 400; line-height: 1.35; }
  .su-photo-story--compact { padding: 46px 0; margin: 44px 0; background: transparent; border-top: 1px solid #dce1e5; border-bottom: 1px solid #dce1e5; }
  .su-photo-story--compact .su-photo-story-inner { max-width: none; }
  .su-photo-story--compact .su-photo-story-head { margin-bottom: 26px; }
  .su-photo-story--compact .su-photo-story-head h2 { font-size: clamp(26px, 3vw, 34px) !important; }
  .su-photo-story--compact .su-photo-story-grid { gap: 18px; }
  .su-photo-story--compact .su-photo-story-item:first-child:not([data-frame='portrait']) { grid-column: span 4; }
  .su-photo-story--compact .su-photo-story-image, .su-photo-story--compact .su-photo-story-item:first-child .su-photo-story-image { padding-bottom: 72%; }
  .su-photo-story--compact .su-photo-story-item[data-frame='portrait'] .su-photo-story-image { padding-bottom: 122%; }
  :global(body.sunday-site.sunday-inner) .su-photo-story { padding-block: 76px; }
  :global(body.sunday-site.sunday-inner) .su-photo-story-inner { max-width: 1240px; }
  :global(body.sunday-site.sunday-inner) .su-photo-story--compact { padding-block: 46px; }
  :global(body.sunday-site.sunday-inner) .su-photo-story--compact .su-photo-story-inner { max-width: none; }
  @media (max-width: 850px) {
    .su-photo-story { padding: 64px 20px; }
    .su-photo-story-head { grid-template-columns: 1fr; gap: 16px; }
    .su-photo-story-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 14px; }
    .su-photo-story-item, .su-photo-story-item:first-child { grid-column: span 1; }
    .su-photo-story-item:first-child:not([data-frame='portrait']) { grid-column: span 2; }
    .su-photo-story-item:first-child:not([data-frame='portrait']) .su-photo-story-image { padding-bottom: 52%; }
    .su-photo-story-image { padding-bottom: 82%; }
    .su-photo-story-item[data-frame='portrait'] .su-photo-story-image { padding-bottom: 122%; }
    :global(.su-photo-story--triptych) .su-photo-story-item:first-child:not([data-frame='portrait']) { grid-column: span 2; }
    :global(.su-photo-story--triptych) .su-photo-story-item:not(:first-child),
    :global(.su-photo-story--seven) .su-photo-story-item:nth-last-child(2),
    :global(.su-photo-story--six) .su-photo-story-item:last-child,
    :global(.su-photo-story--five-portrait) .su-photo-story-item:nth-last-child(2),
    :global(.su-photo-story--five-portrait) .su-photo-story-item:last-child { grid-column: span 1; }
    :global(.su-photo-story--triptych) .su-photo-story-item:first-child:not([data-frame='portrait']) .su-photo-story-image { padding-bottom: 52%; }
    .su-photo-story--compact .su-photo-story-item:first-child:not([data-frame='portrait']) { grid-column: span 2; }
    .su-photo-story--compact .su-photo-story-item:first-child:not([data-frame='portrait']) .su-photo-story-image { padding-bottom: 52%; }
  }
  @media (max-width: 520px) {
    .su-photo-story { padding: 58px 20px; }
    .su-photo-story-head { margin-bottom: 26px; }
    .su-photo-story-head > p { font-size: 15px; }
    .su-photo-story-grid { gap: 26px 12px; }
    .su-photo-story-image { padding-bottom: 110%; border-radius: 12px; }
    .su-photo-story-item:first-child:not([data-frame='portrait']) .su-photo-story-image { padding-bottom: 69%; }
    .su-photo-story-item[data-frame='portrait'] .su-photo-story-image { padding-bottom: 122%; }
    .su-photo-story-item figcaption { gap: 6px; padding-top: 8px; font-size: 12px; line-height: 1.35; }
    .su-photo-story-number { font-size: 10px; }
    .su-photo-story-item small { font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .su-photo-story-image img { transition: none; } }
</style>
