---
import { aboutHeroFilm } from '../../data/aboutHeroFilm';
---
<figure class="zi-about-film">
  <video
    data-about-hero-video
    controls
    muted
    loop
    playsinline
    preload="none"
    poster={aboutHeroFilm.poster}
    width={aboutHeroFilm.width}
    height={aboutHeroFilm.height}
    aria-label="HAN XING company tour"
  >
    <source src={aboutHeroFilm.src} type="video/mp4" />
    Your browser does not support inline video playback.
  </video>
</figure>

<script>
  const film = document.querySelector<HTMLVideoElement>('[data-about-hero-video]');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if (film && !motion.matches && !connection?.saveData) {
    const start = () => {
      if (!motion.matches && film.paused) void film.play().catch(() => {});
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        observer.disconnect();
        start();
      }, { threshold: 0.25 });
      observer.observe(film);
    } else start();
  }
</script>

<style>
  .zi-about-film {
    margin: 0;
    min-width: 0;
    aspect-ratio: 30 / 17;
    overflow: hidden;
    border-radius: var(--su-photo-radius, 18px);
    background: #edf0f3;
  }
  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
