---
import { products, type Application } from '../data/site';
import InquiryCallout from './InquiryCallout.astro';
import { applicationReference } from '../data/applicationReference';
import { seriesFormats } from '../data/productReference';
import '../styles/hvac-reference.css';
interface Props { application: Application }
const { application } = Astro.props;
const content = applicationReference[application.slug];
const compared = application.series.map(code => products.find(p => p.code === code)!);
const inquiry = '/contact/?application=' + application.slug + '&request=quote#inquiry-form';
const compareRows = [
  { label: 'Duty', values: compared.map(p => content.functions[p.code]) },
  { label: 'Case / connection', values: compared.map(p => seriesFormats[p.code].case + ' · ' + seriesFormats[p.code].connections) },
  { label: application.slug === 'fans-and-ventilation' ? 'Electrical rating' : 'µF / VAC range', values: compared.map(p => application.slug === 'fans-and-ventilation' ? 'Match the original µF. Series voltage range: ' + p.voltage + '. See the series page for capacitance ranges.' : p.capacitance + ' · ' + p.voltage) },
  ...(content.showDimensions ? [{ label: 'Published case-size range', values: compared.map(p => p.dimensions + '. Use the model drawing for dimensions.') }] : []),
  { label: 'Important check', values: compared.map(p => content.confirmations[p.code]) },
];
---
<article class="hvr-reference review-application-reference" data-application={application.slug}>
  <div class="hvr-wrap">
    <section class="hvr-hero" aria-labelledby="application-title">
      <div class="hvr-introduction">
        <nav class="hvr-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/applications/">Applications</a><span>/</span><span aria-current="page">{application.shortName}</span></nav>
        <h1 id="application-title">{application.shortName}</h1>
        <p class="hvr-hero-summary">{application.listing}</p>
        <div class="hvr-actions"><a class="hvr-button" href="#review">Check motor requirements</a><a class="hvr-secondary" href="#quote-details">Inquiry checklist</a></div>
      </div>
      <figure class="hvr-hero-photo"><img src={application.image} alt={application.imageAlt} width="1200" height={application.imageHeight} fetchpriority="high" /></figure>
    </section>

    <section class="hvr-section" id="review" aria-labelledby="circuit-title">
      <h2 id="circuit-title">Motor circuit &amp; original capacitor</h2>
      <div class="hvr-circuit-paths">{content.paths.map(path => <div><h3>{path.title}</h3><p>{path.text}</p><a class="hvr-path-link" href={path.href}>{path.link}</a></div>)}</div>
      <p class="technical-body-copy">{content.decision}</p>
    </section>

    <section class="hvr-section" id="series-comparison" aria-labelledby="comparison-title">
      <h2 id="comparison-title">Compare capacitor series</h2>
      <div class="hvr-table-wrap hvr-desktop-comparison" role="region" aria-label={application.series.join(' and ') + ' comparison'} tabindex="0">
        <table class="hvr-comparison"><caption class="visually-hidden">{content.comparisonTitle}</caption>
          <thead><tr><th scope="col">Field</th>{compared.map(p => <th scope="col"><a href={'/products/' + p.slug + '/'}><strong>{p.code}</strong></a><span>{p.function} duty · {p.shortName}</span></th>)}</tr></thead>
          <tbody>{compareRows.map(row => <tr><th scope="row">{row.label}</th>{row.values.map(value => <td>{value}</td>)}</tr>)}
            <tr class="hvr-sample-row"><th scope="row">Sample photograph</th>{compared.map(p => <td><figure><div class="hvr-sample-photo" data-series={p.code}><img src={p.image} alt={p.imageAlt} width="2000" height="2000" loading="lazy" /></div><figcaption>{p.code === 'CBB61' ? 'Blade-terminal samples' : 'Series sample'}</figcaption></figure></td>)}</tr>
            <tr><th scope="row">Full series details</th>{compared.map(p => <td><a class="hvr-series-link" href={'/products/' + p.slug + '/'}>View {p.code}</a></td>)}</tr>
          </tbody>
        </table>
      </div>
      <div class="hvr-mobile-comparison">{compared.map((p,index) => <div class="hvr-series-summary"><h3><a href={'/products/' + p.slug + '/'}>{p.code}</a></h3><dl>{compareRows.map(row => <div><dt>{row.label}</dt><dd>{row.values[index]}</dd></div>)}</dl><div class="hvr-sample-photo"><img src={p.image} alt={p.imageAlt} width="2000" height="2000" loading="lazy" /></div><a class="hvr-series-link" href={'/products/' + p.slug + '/'}>View {p.code} details</a></div>)}</div>
      <p class="technical-body-copy">{content.comparisonIntro}</p>
      <p class="hvr-note">Use the proposed model datasheet and motor specification to confirm temperature, tolerance and dimensions.</p>
    </section>

    <section class="hvr-section" id="fit-check" aria-labelledby="checks-title">
      <h2 id="checks-title">Fit and connection check</h2>
      <div class="hvr-check-layout">
        <figure class="hvr-fit-photo"><div class="hvr-fit-image"><img src={content.detail.image} alt={content.detail.alt} width="2000" height="2000" loading="lazy" /></div><figcaption>{content.detail.caption}</figcaption></figure>
        <div><ul class="hvr-inquiry-checklist">{content.fitChecks.map(([title,description]) => <li><h3>{title}</h3><p>{description}</p></li>)}</ul><div class="hvr-fit-guides"><a class="hvr-secondary hvr-guide" href={content.guide.href}>{content.guide.label}</a>{application.slug === 'pumps-and-water-systems' && <a class="hvr-secondary hvr-guide" href="/resources/dimensions-terminals-mounting/">Record dimensions & connections</a>}</div></div>
      </div>
    </section>

    <InquiryCallout id="quote-details" contained href={inquiry} defaultSeries={application.series[0]}>
      <ul>{content.inquiryFields.map(field => <li>{field}</li>)}</ul>
      <a class="card-link" href="/buying-guide/#rfq-template">Quotation checklist</a>
    </InquiryCallout>
  </div>
</article>
