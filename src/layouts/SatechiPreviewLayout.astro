---
import '@fontsource-variable/inter';
import PreviewHeader from '../components/satechi-preview/PreviewHeader.astro';
import Footer from '../components/Footer.astro';
import '../styles/satechi-fidelity.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="theme-color" content="#f9f7f3" />
    <link rel="icon" href="/favicon.svg?v=hanxing" type="image/svg+xml" />
  </head>
  <body class="satechi-preview">
    <a class="visually-hidden" href="#main">Skip to content</a>
    <PreviewHeader />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
