---
import selectedLayoutCss from '../styles/layout-selected.css?inline';
import legacyLayoutCss from '../styles/layout-legacy.css?inline';
import { indexablePaths as indexedStylePaths } from '../lib/seoRoutes';
import interCss from '@fontsource-variable/inter/index.css?url';
import Header from '../components/Header.astro';
import PreviewHeader from '../components/satechi-preview/PreviewHeader.astro';
import fidelityCss from '../styles/satechi-fidelity.css?url';
import sitePreviewCss from '../styles/satechi-site.css?url';
import innerPreviewCss from '../styles/satechi-inner.css?url';
import mediaPreviewCss from '../styles/satechi-media.css?url';
import linkNavigationCss from '../styles/satechi-link-navigation.css?url';
import footerPreviewCss from '../styles/satechi-footer.css?url';
import typographyPreviewCss from '../styles/satechi-typography.css?url';
import coherencePreviewCss from '../styles/satechi-coherence.css?url';
import oemImageryCss from '../styles/satechi-oem-imagery.css?url';
import rhythmPreviewCss from '../styles/satechi-rhythm.css?url';
import brochurePreviewCss from '../styles/satechi-brochure.css?url';
import interactionCss from '../styles/interaction-states.css?url';
import interactionInlineCss from '../styles/interaction-states.css?inline';
import { isSatechiPreview, isSundayRoute } from '../lib/visualPreview';
import Footer from '../components/Footer.astro';
import SundayHeader from '../components/sunday/SundayHeader.astro';
import SundayFooter from '../components/sunday/SundayFooter.astro';
import sundayCss from '../styles/sunday-home.css?url';
import sundayInnerCss from '../styles/sunday-inner.css?url';
import sundayInlineCss from '../styles/sunday-home.css?inline';
import sundayInnerInlineCss from '../styles/sunday-inner.css?inline';
import { SITE_NAME } from '../data/site';
import { publicSiteReady } from '../lib/publicSite';
import { pageBreadcrumbs } from '../lib/pageBreadcrumbs';
import { pageSeo } from '../lib/pageSeo';
import { alternates } from '../i18n/routes';
interface Props { title: string; description: string; noindex?: boolean; homeDesign?: boolean; }
const { title, description, noindex = false, homeDesign = false } = Astro.props;
const sundayTheme = isSundayRoute(Astro.url.pathname);
const useSelectedLayout = sundayTheme && indexedStylePaths.has(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const previewOnly = !publicSiteReady(Astro.site);
const fullTitle = /\b(?:hanxing capacitor|han xing)\b/i.test(title) ? title : `${title} | ${SITE_NAME}`;
const seo = pageSeo(Astro.url.pathname, fullTitle, description, canonical);
// Pages with a visible, page-specific trail already include it in their graph.
const breadcrumbs = noindex || seo.schema['@graph'].some(node => node['@type'] === 'BreadcrumbList')
  ? null : pageBreadcrumbs(Astro.url.pathname, title, canonical);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && alternates(Astro.url.pathname,Astro.site?.origin ?? Astro.url.origin).map(link=><link rel="alternate" hreflang={link.lang} href={link.href} />)}
    {(noindex || previewOnly || isSatechiPreview) && <meta name="robots" content={isSatechiPreview ? 'noindex,nofollow,noarchive' : 'noindex,follow'} />}
    {!noindex && !previewOnly && !isSatechiPreview && <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />}
    {!noindex && !previewOnly && !isSatechiPreview && <link rel="sitemap" type="application/xml" href={new URL('/sitemap-index.xml', Astro.site).toString()} />}
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={seo.image} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(seo.schema).replace(/</g, '\\u003c')} />}
    {breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\\u003c')} />}
    <link rel="icon" href="/favicon.svg?v=hanxing" type="image/svg+xml" />
    <slot name="head" />
    {isSatechiPreview && !sundayTheme && <><link rel="stylesheet" href={fidelityCss} /><link rel="stylesheet" href={sitePreviewCss} /><link rel="stylesheet" href={innerPreviewCss} /><link rel="stylesheet" href={mediaPreviewCss} /><link rel="stylesheet" href={linkNavigationCss} /><link rel="stylesheet" href={footerPreviewCss} /><link rel="stylesheet" href={typographyPreviewCss} /><link rel="stylesheet" href={coherencePreviewCss} /><link rel="stylesheet" href={oemImageryCss} /><link rel="stylesheet" href={rhythmPreviewCss} /><link rel="stylesheet" href={brochurePreviewCss} /></>}
    {useSelectedLayout ? <style is:inline set:html={interactionInlineCss}></style> : <link rel="stylesheet" href={interactionCss} />}
    {!useSelectedLayout && <link rel="stylesheet" href={interCss} />}
    {sundayTheme && <><link rel="preload" href="/fonts/sunday/jakarta-latin.woff2" as="font" type="font/woff2" crossorigin /><link rel="preload" href="/fonts/sunday/geist-latin.woff2" as="font" type="font/woff2" crossorigin />{useSelectedLayout ? <style is:inline set:html={sundayInlineCss}></style> : <link rel="stylesheet" href={sundayCss} />}{!homeDesign && (useSelectedLayout ? <style is:inline set:html={sundayInnerInlineCss}></style> : <link rel="stylesheet" href={sundayInnerCss} />)}</>}
    <style is:inline data-layout-styles={useSelectedLayout ? 'selected' : 'legacy'} set:html={useSelectedLayout ? selectedLayoutCss : legacyLayoutCss}></style>
  </head>
  <body class:list={[homeDesign ? 'sunday-home sunday-site' : sundayTheme ? 'sunday-site sunday-inner' : isSatechiPreview ? 'satechi-preview satechi-site' : 'porcelain-site reference-site', {'is-home': isSatechiPreview && Astro.url.pathname === '/', 'has-collection-cover':!homeDesign && ['/products/','/applications/'].includes(Astro.url.pathname)}]}>
    <a class="visually-hidden" href="#main">Skip to content</a>
    {sundayTheme ? <SundayHeader /> : isSatechiPreview ? <PreviewHeader /> : <Header />}
    <main id="main" tabindex="-1"><slot /></main>
    {sundayTheme ? <SundayFooter /> : <Footer />}
    <script>
      import {initSiteImageFeedback} from '../lib/siteImageFeedback';
      import {initSiteTracking} from '../lib/siteTracking';
      import {initLanguageLinks} from '../i18n/client';
      initSiteImageFeedback();
      initSiteTracking();
      initLanguageLinks();
    </script>
  </body>
</html>


