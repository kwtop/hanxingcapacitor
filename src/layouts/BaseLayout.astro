---
import '@fontsource-variable/inter';
import '../styles/legacy.css';
import '../styles/system.css';
import '../styles/homepage.css';
import '../styles/site-editorial.css';
import '../styles/site-upgrade.css';
import '../styles/finesse-redesign.css';
import '../styles/site-porcelain.css';
import '../styles/review-products.css';
import '../styles/review-resources.css';
import '../styles/review-procurement.css';
import '../styles/review-site.css';
import '../styles/reference-system.css';
import '../styles/reference-products.css';
import '../styles/reference-support.css';
import '../styles/selected-site.css';
import '../styles/internal-links.css'; // Shared standalone actions, including the selected homepage.
import '../styles/content-alignment.css';
import '../styles/product-gallery.css'; // Original-photo filmstrip and responsive arrow controls.
import '../styles/navigation.css'; // Shared overview links and submenu interaction states.
import '../styles/inquiry-actions.css';
import '../styles/page-rhythm.css'; // Shared module breathing room, independent of inner content spacing.
import '../styles/application-editorial.css'; // Selected Applications index and detail hierarchy.
import '../styles/layout-balance.css'; // Responsive image/copy proportions across existing templates.
import Header from '../components/Header.astro';
import PreviewHeader from '../components/satechi-preview/PreviewHeader.astro';
import fidelityCss from '../styles/satechi-fidelity.css?url';
import sitePreviewCss from '../styles/satechi-site.css?url';
import innerPreviewCss from '../styles/satechi-inner.css?url';
import mediaPreviewCss from '../styles/satechi-media.css?url';
import linkNavigationCss from '../styles/satechi-link-navigation.css?url';
import footerPreviewCss from '../styles/satechi-footer.css?url';
import typographyPreviewCss from '../styles/satechi-typography.css?url';
import coherencePreviewCss from '../styles/satechi-coherence.css?url';
import oemImageryCss from '../styles/satechi-oem-imagery.css?url';
import rhythmPreviewCss from '../styles/satechi-rhythm.css?url';
import brochurePreviewCss from '../styles/satechi-brochure.css?url';
import interactionCss from '../styles/interaction-states.css?url';
import { isSatechiPreview } from '../lib/visualPreview';
import Footer from '../components/Footer.astro';
import { SITE_NAME } from '../data/site';
import { publicSiteReady } from '../lib/publicSite';
import { pageBreadcrumbs } from '../lib/pageBreadcrumbs';
import { pageSeo } from '../lib/pageSeo';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const previewOnly = !publicSiteReady(Astro.site);
const breadcrumbs = noindex ? null : pageBreadcrumbs(Astro.url.pathname, title, canonical);
const fullTitle = /\b(?:hanxing capacitor|han xing)\b/i.test(title) ? title : `${title} | ${SITE_NAME}`;
const seo = pageSeo(Astro.url.pathname, fullTitle, description, canonical);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || previewOnly || isSatechiPreview) && <meta name="robots" content={isSatechiPreview ? 'noindex,nofollow,noarchive' : 'noindex,follow'} />}
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={seo.image} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(seo.schema).replace(/</g, '\\u003c')} />}
    {breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\\u003c')} />}
    <link rel="icon" href="/favicon.svg?v=hanxing" type="image/svg+xml" />
    <slot name="head" />
    {isSatechiPreview && <><link rel="stylesheet" href={fidelityCss} /><link rel="stylesheet" href={sitePreviewCss} /><link rel="stylesheet" href={innerPreviewCss} /><link rel="stylesheet" href={mediaPreviewCss} /><link rel="stylesheet" href={linkNavigationCss} /><link rel="stylesheet" href={footerPreviewCss} /><link rel="stylesheet" href={typographyPreviewCss} /><link rel="stylesheet" href={coherencePreviewCss} /><link rel="stylesheet" href={oemImageryCss} /><link rel="stylesheet" href={rhythmPreviewCss} /><link rel="stylesheet" href={brochurePreviewCss} /></>}
    <link rel="stylesheet" href={interactionCss} />
  </head>
  <body class:list={[isSatechiPreview ? 'satechi-preview satechi-site' : 'porcelain-site reference-site', {'is-home': isSatechiPreview && Astro.url.pathname === '/', 'has-collection-cover':isSatechiPreview && ['/products/','/applications/'].includes(Astro.url.pathname)}]}>
    <a class="visually-hidden" href="#main">Skip to content</a>
    {isSatechiPreview ? <PreviewHeader /> : <Header />}
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import {initSiteImageFeedback} from '../lib/siteImageFeedback';
      initSiteImageFeedback();
    </script>
  </body>
</html>


