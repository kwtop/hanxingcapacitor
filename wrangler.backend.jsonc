{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanxing-admin-local",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public/admin-assets", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "hanxing-site", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "dev": { "ip": "127.0.0.1", "port": 8796 }
}
