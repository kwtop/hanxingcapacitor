# Set the same value for the public build AND runtime. Omit in local previews.
# Confirm the approved public domain before enabling indexing.
PUBLIC_SITE_URL=https://www.hanxingcapacitor.com
# Development only: Astro forwards backend requests to the local Cloudflare Worker.
LOCAL_BACKEND_URL=http://127.0.0.1:8796
# Runtime secrets and D1 are configured separately, not bundled into the website.
# See .dev.vars.example and docs/ADMIN-SETUP.md.
