# Set the same value for the public build AND runtime. Omit in local previews.
# Confirm the approved public domain before enabling indexing.
PUBLIC_SITE_URL=https://www.hanxingcapacitor.com
# The current website creates drafts only. Enable server submissions only after
# the contact flow, privacy notice, storage and delivery have been reviewed together.
ENABLE_ONLINE_INQUIRIES=false
INQUIRY_STORE_DIR=/absolute/persistent/path/for/inquiries
SALES_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
